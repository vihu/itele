// Search: channels by name, movies and series by title, and programmes,
// across every provider. The query is typed in the top bar.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ChannelLogo, Hint, LiveMarker } from "atoms.slint";
import { SearchItem } from "models.slint";

export { SearchItem }

// The search, shared by the top bar's field, the results under it and the
// Search screen; the Rust side fills the results.
export global SearchData {
    in-out property <string> query;
    in property <[SearchItem]> items;
    in property <int> index: -1;
    in property <string> note;
    callback edited(string);
    callback picked(int);
    // Up and Down move through the results.
    callback move(int);
    // Opens the Search screen with every result.
    callback all();
}

// One result; `compact` for the results under the top bar's field.
export component ResultRow inherits Rectangle {
    in property <SearchItem> item;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked();
    height: compact ? 52px : 60px;
    border-radius: compact ? Theme.radius-sm : Theme.radius-md;
    background: item.kind == 2 ? transparent : selected || (compact && touch.has-hover) ? (compact ? Theme.surface-3 : Theme.surface-2) : touch.has-hover ? Theme.surface-1 : transparent;
    border-width: selected && item.kind != 2 ? 1px : 0px;
    border-color: Theme.accent-line;
    if root.item.kind == 2: Text {
        x: 12px;
        y: parent.height - self.height - 6px;
        text: root.item.title;
        color: Theme.text-3;
        font-size: Theme.fs-sm;
        font-weight: 700;
    }
    if root.item.kind != 2: HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 16px;
        if root.item.kind != 3: VerticalLayout {
            alignment: center;
            ChannelLogo {
                short: root.item.short;
                tint: root.item.tint;
                logo: root.item.logo;
                has-logo: root.item.has-logo;
            }
        }
        // A poster, in the logo's width.
        if root.item.kind == 3: HorizontalLayout {
            width: 56px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 48px;
                    border-radius: 4px;
                    clip: true;
                    background: @linear-gradient(180deg, root.item.tint 0%, Theme.surface-1 100%);
                    if root.item.has-logo: Image {
                        width: 100%;
                        height: 100%;
                        source: root.item.logo;
                        image-fit: cover;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                color: Theme.text;
                font-size: root.compact ? Theme.fs-sm : Theme.fs-md;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                color: Theme.text-3;
                font-size: root.compact ? Theme.fs-xs : Theme.fs-sm;
                overflow: elide;
            }
        }
        if root.item.live: VerticalLayout {
            alignment: center;
            LiveMarker { }
        }
        if root.item.replay: VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/catchup.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.text-3;
            }
        }
        Text {
            max-width: root.compact ? 150px : 320px;
            text: root.item.detail;
            color: Theme.text-2;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.item.kind != 2;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component SearchScreen inherits Rectangle {
    callback navigate(int);

    // Scrolls the results so `row` is visible; every row is 60px.
    public function reveal(row: int) {
        if (row <= 1) {
            list.content-y = 0;
        } else if ((row + 1) * 60px > -list.content-y + list.visible-height) {
            list.content-y = -((row + 1) * 60px - list.visible-height);
        } else if (row * 60px < -list.content-y) {
            list.content-y = -row * 60px;
        }
    }

    background: Theme.bg;
    // The keys, when a click took focus from the top bar's field.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                SearchData.move(-1);
            } else if (event.text == Key.DownArrow) {
                SearchData.move(1);
            } else if (event.text == Key.Return) {
                SearchData.picked(SearchData.index);
            } else if (event.text == Key.Escape) {
                root.navigate(1);
            } else if (event.text == "/" || (event.modifiers.control && event.text.to-lowercase() == "k")) {
                root.navigate(5);
            } else {
                return reject;
            }
            accept
        }
    }
    VerticalLayout {
        padding-left: 48px;
        padding-right: 48px;
        padding-top: 8px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 14px;
            Text {
                text: "Search";
                color: Theme.text;
                font-size: Theme.fs-3xl;
                font-weight: 800;
            }
            Text {
                text: SearchData.query == "" ? "" : "\u{201c}" + SearchData.query + "\u{201d}";
                color: Theme.text-3;
                font-size: Theme.fs-lg;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        if SearchData.note != "" || SearchData.query == "": Text {
            text: SearchData.query == "" ? "Type in the search bar above: channels, movies, series and programmes, across all providers." : SearchData.note;
            color: Theme.text-3;
            font-size: Theme.fs-md;
            wrap: word-wrap;
        }
        list := ListView {
            vertical-stretch: 1;
            for item[i] in SearchData.items: ResultRow {
                item: item;
                selected: i == SearchData.index;
                clicked => {
                    SearchData.picked(i);
                }
            }
        }
        Rectangle {
            height: 44px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 22px;
                alignment: start;
                Hint {
                    keys: ["↑", "↓"];
                    label: "Choose";
                }
                Hint {
                    keys: ["Enter"];
                    label: "Watch or open";
                }
                Hint {
                    keys: ["Esc"];
                    label: "Back";
                }
            }
        }
    }
}
