// Favorites: the user's channels, movies and series across providers, in
// their order, each tagged with its provider; a filter by provider, and the
// selected channel's preview. Layout: .ai-docs/mockups/09-favorites.html.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Hint } from "atoms.slint";
import { ChannelItem, PosterItem, ProgrammeInfo, ProviderItem, UpcomingItem } from "models.slint";
import { ChannelPreview } from "preview.slint";
import { FavoriteRow, ProviderFilter } from "favorite-rows.slint";
import { TitleGrid } from "title-grid.slint";

export component FavoritesScreen inherits Rectangle {
    in property <[ChannelItem]> channels;
    in property <int> channel-index;
    // Favorite channels, movies and series, across providers.
    in property <[int]> counts;
    in property <[ProviderItem]> providers;
    // The provider shown; -1 is every provider.
    in property <int> filter: -1;
    // The tab showing: 0 channels, 1 movies, 2 series.
    in property <int> tab;
    // The favorite movies or series of the tab showing.
    in property <[PosterItem]> titles;
    in-out property <int> title-index;
    in property <image> frame;
    in property <string> video-note;
    in property <ProgrammeInfo> programme;
    in property <[UpcomingItem]> upcoming;
    out property <length> video-width: preview.video-width;
    out property <length> video-height: preview.video-height;
    callback channel-selected(int);
    callback watch();
    // F, Delete or the heart: the favorite channel at a row goes.
    callback favorite(int);
    // Alt+Up and Alt+Down: the selected favorite moves.
    callback reorder(int);
    callback filter-selected(int);
    callback tab-selected(int);
    callback open-title(int);
    callback remove-title(int);
    callback navigate(int);
    // Rows `first` to `first + count` are on screen, for lazy logos.
    callback rows-visible(int, int);

    property <int> count: root.counts[0];
    property <int> first-visible: floor(-list.content-y / 76px);
    changed first-visible => {
        root.rows-visible(root.first-visible, ceil(list.visible-height / 76px) + 1);
    }
    property <ChannelItem> current: root.count > 0 && root.channel-index >= 0 && root.channel-index < root.channels.length ? root.channels[root.channel-index] : { name: "" };

    public function focus-keys() {
        keys.focus();
    }

    // Scrolls the list so row `index` is visible.
    public function reveal(index: int) {
        if (index * 76px < -list.content-y) {
            list.content-y = -index * 76px;
        } else if ((index + 1) * 76px > -list.content-y + list.visible-height) {
            list.content-y = -((index + 1) * 76px - list.visible-height);
        }
    }

    function select(index: int) {
        if (root.count > 0 && root.channels.length > 0) {
            let target = max(0, min(root.channels.length - 1, index));
            root.channel-selected(target);
            root.reveal(target);
        }
    }

    // The arrows, Enter and F on the Movies and Series tabs.
    function title-key(event: KeyEvent) -> bool {
        let key = event.text.to-lowercase();
        if (event.text == Key.LeftArrow) {
            grid.select(root.title-index - 1);
        } else if (event.text == Key.RightArrow) {
            grid.select(root.title-index + 1);
        } else if (event.text == Key.UpArrow) {
            grid.select(root.title-index - grid.columns);
        } else if (event.text == Key.DownArrow) {
            grid.select(root.title-index + grid.columns);
        } else if (event.text == Key.Return && root.titles.length > 0) {
            root.open-title(root.title-index);
        } else if ((key == "f" || event.text == Key.Delete) && root.titles.length > 0) {
            root.remove-title(root.title-index);
        } else {
            return false;
        }
        true
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.Tab) {
                root.tab-selected(root.tab + 1);
            } else if (event.text == Key.Backtab) {
                root.tab-selected(root.tab - 1);
            } else if (event.text == Key.Escape) {
                root.navigate(1);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else if (root.tab != 0) {
                return root.title-key(event) ? accept : reject;
            } else if (event.modifiers.alt && event.text == Key.UpArrow) {
                root.reorder(-1);
            } else if (event.modifiers.alt && event.text == Key.DownArrow) {
                root.reorder(1);
            } else if (event.text == Key.UpArrow) {
                root.select(root.channel-index - 1);
            } else if (event.text == Key.DownArrow) {
                root.select(root.channel-index + 1);
            } else if (event.text == Key.PageUp) {
                root.select(root.channel-index - 8);
            } else if (event.text == Key.PageDown) {
                root.select(root.channel-index + 8);
            } else if (event.text == Key.Home) {
                root.select(0);
            } else if (event.text == Key.End) {
                root.select(root.channels.length - 1);
            } else if (event.text == Key.Return && root.current.name != "") {
                root.watch();
            } else if ((key == "f" || event.text == Key.Delete) && root.current.name != "") {
                root.favorite(root.channel-index);
            } else {
                return reject;
            }
            accept
        }
    }
    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 6px;
                HorizontalLayout {
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-bottom: 18px;
                    spacing: 24px;
                    VerticalLayout {
                        alignment: end;
                        spacing: 2px;
                        Text {
                            text: "Favorites";
                            color: Theme.text;
                            font-size: Theme.fs-3xl;
                            font-weight: 800;
                        }
                        Text {
                            text: "Yours, across every provider, in the order you set";
                            color: Theme.text-3;
                            font-size: Theme.fs-sm;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.providers.length > 1: VerticalLayout {
                        alignment: end;
                        ProviderFilter {
                            providers: root.providers;
                            selected: root.filter;
                            chosen(i) => {
                                root.filter-selected(i);
                                keys.focus();
                            }
                        }
                    }
                }
                // Channels, movies, series.
                Rectangle {
                    height: 44px;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 36px;
                        spacing: 4px;
                        alignment: start;
                        for name[i] in ["Channels", "Movies", "Series"]: Rectangle {
                            width: label.preferred-width + 28px;
                            label := HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: name;
                                    color: i == root.tab || tab-touch.has-hover ? Theme.text : Theme.text-2;
                                    font-size: Theme.fs-md;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.counts[i];
                                    color: Theme.text-3;
                                    font-size: Theme.fs-sm;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                background: i == root.tab ? Theme.accent : transparent;
                            }
                            tab-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.tab-selected(i);
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                if root.counts[root.tab] == 0: VerticalLayout {
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-top: 40px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.tab == 0 ? "No favorite channels yet" : root.tab == 1 ? "No favorite movies yet" : "No favorite series yet";
                        color: Theme.text;
                        font-size: Theme.fs-xl;
                        font-weight: 700;
                    }
                    Text {
                        text: root.tab == 0 ? "Press F on any channel in Live TV or the guide, or click its heart. Favorites from every provider gather here, in the order you choose."
                            : "Open a title and press F, or click Favorite on its page. Favorites from every provider gather here.";
                        color: Theme.text-2;
                        font-size: Theme.fs-md;
                        wrap: word-wrap;
                    }
                }
                if root.counts[root.tab] > 0 && (root.tab == 0 ? root.channels.length : root.titles.length) == 0: VerticalLayout {
                    padding-left: 36px;
                    padding-top: 40px;
                    alignment: start;
                    Text {
                        text: "No favorites from this provider";
                        color: Theme.text-2;
                        font-size: Theme.fs-md;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        list := ListView {
                            visible: root.tab == 0 && root.count > 0;
                            for channel[i] in root.channels: FavoriteRow {
                                item: channel;
                                selected: i == root.channel-index;
                                clicked => {
                                    root.channel-selected(i);
                                    keys.focus();
                                }
                                double-clicked => {
                                    root.channel-selected(i);
                                    root.watch();
                                }
                                heart-clicked => {
                                    root.favorite(i);
                                }
                            }
                        }
                    }
                    grid := TitleGrid {
                        x: 36px;
                        width: parent.width - 72px;
                        visible: root.tab != 0;
                        items: root.titles;
                        index <=> root.title-index;
                        open(i) => {
                            keys.focus();
                            root.open-title(i);
                        }
                    }
                }
            }
            preview := ChannelPreview {
                visible: root.tab == 0 && root.count > 0 && root.channels.length > 0;
                width: root.tab == 0 ? 460px : 0px;
                frame: root.frame;
                video-note: root.video-note;
                current: root.current;
                programme: root.programme;
                upcoming: root.upcoming;
                favorite-text: "Remove";
                watch => {
                    root.watch();
                }
                favorite => {
                    root.favorite(root.channel-index);
                }
            }
        }
        // Shortcut hints.
        Rectangle {
            height: 44px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                padding-left: 24px;
                spacing: 22px;
                alignment: start;
                Hint {
                    keys: root.tab == 0 ? ["↑", "↓"] : ["←", "→", "↑", "↓"];
                    label: "Choose";
                }
                Hint {
                    keys: ["Enter"];
                    label: root.tab == 0 ? "Watch" : "Open";
                }
                if root.tab == 0: Hint {
                    keys: ["Alt", "↑", "↓"];
                    label: "Move";
                }
                Hint {
                    keys: ["F"];
                    label: "Remove";
                }
                Hint {
                    keys: ["Tab"];
                    label: "Channels, movies, series";
                }
            }
        }
    }
}
