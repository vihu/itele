// Data the Rust side hands to the screens.

export struct GroupItem {
    name: string,
    count: string,
    // The group's provider, shown when every provider is listed.
    provider: string,
}

export struct ChannelItem {
    number: string,
    name: string,
    group: string,
    // The channel's provider and its hue, when rows from several show.
    provider: string,
    hue: color,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    archive: string,
    // The programme airing now, empty without a guide.
    now-title: string,
    // How far into it, 0 to 1; below 0 without a guide.
    now-progress: float,
    next-time: string,
    next-title: string,
}

// The selected channel's programme, for the preview and the banner.
export struct ProgrammeInfo {
    title: string,
    // For example "21:00 – 22:00".
    time: string,
    // For example "38 min left".
    left: string,
    description: string,
    progress: float,
}

export struct UpcomingItem {
    time: string,
    title: string,
}

// One programme in the guide grid, positioned in minutes from the window
// start.
export struct GuideCell {
    title: string,
    time: string,
    x: float,
    width: float,
    // 0 ended, 1 on now, 2 upcoming.
    state: int,
    selected: bool,
    // Replayable from the provider's catch-up.
    replay: bool,
}

export struct GuideRow {
    number: string,
    name: string,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    cells: [GuideCell],
}

// A ruler label, in minutes from the window start.
export struct GuideTick {
    x: float,
    label: string,
}

// The selected programme in the guide.
export struct GuideDetails {
    title: string,
    channel: string,
    time: string,
    // For example "Starts in 38 min" or "Ended 2 h ago".
    when: string,
    description: string,
    // On now, so Enter watches the channel.
    live: bool,
    // Ended and replayable, so Enter plays it from the start.
    replay: bool,
}

// A signed-in provider, for the switcher and the settings list.
export struct ProviderItem {
    name: string,
    user: string,
    status: string,
    // Initials, and for example "Until 12 Jan 2027", for the account menu.
    avatar: string,
    meta: string,
}

// A search result: a channel, a programme, a section heading, or a movie
// or series (whose logo is its poster).
export struct SearchItem {
    // 0 channel, 1 programme, 2 heading, 3 movie or series.
    kind: int,
    title: string,
    subtitle: string,
    detail: string,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    // On now: Enter watches it.
    live: bool,
    // Ended and replayable.
    replay: bool,
}

// A movie or series in the poster grid.
export struct PosterItem {
    title: string,
    // Year, and the provider when every provider is listed.
    detail: string,
    // Out of 10, for example "7.4"; empty when unrated.
    rating: string,
    tint: color,
    poster: image,
    has-poster: bool,
    // How far it was watched, 0 to 1; below 0 when never started.
    progress: float,
    watched: bool,
}

// The detail page of a movie or a series.
export struct TitleDetails {
    title: string,
    // For example "2024 · 1 h 34 min · Comedy, Family".
    meta: string,
    // Out of 10, for example "7.8"; empty when unrated.
    rating: string,
    plot: string,
    // For example "With Ana Dimas, Teo Larsen · Directed by Ida Sund".
    credits: string,
    tint: color,
    poster: image,
    has-poster: bool,
    backdrop: image,
    has-backdrop: bool,
    // Shown while details load, or when they fail.
    note: string,
    // Where the back button goes, for example "Movies".
    back-label: string,
    // The main button, for example "Play" or "Resume".
    play-label: string,
    // Time left when resuming, for example "18 min left".
    left: string,
    // Offer "From the beginning" beside Resume.
    restart: bool,
}

// A season tab on a series' page.
export struct SeasonItem {
    name: string,
    // Episodes in it, for example "10".
    count: string,
}

// An episode in a series' list.
export struct EpisodeItem {
    number: string,
    title: string,
    plot: string,
    // For example "24 min"; empty when unknown.
    duration: string,
    still: image,
    has-still: bool,
    // For example "S2 E4".
    code: string,
    // How far it was watched, 0 to 1; below 0 when never started.
    progress: float,
    watched: bool,
    // Started and not finished: Play resumes it.
    resumable: bool,
    // When resumable, for example "18 min left".
    left: string,
}

// One "label: value" fact about a provider in Settings.
export struct Fact {
    label: string,
    value: string,
}

// A signed-in provider in Settings.
export struct ProviderDetails {
    // The name the user gave it; empty for the automatic one.
    name: string,
    // The automatic name, shown while the field is empty.
    placeholder: string,
    // For example "Active · until 12 Jan 2027".
    state: string,
    // Something needs attention: the state dot turns amber.
    warn: bool,
    // What went wrong last, or empty.
    notice: string,
    // A refresh is running.
    busy: bool,
    // Two rows of four facts: server, user, connections, lists; then
    // channels, movies, series, guide.
    facts-top: [Fact],
    facts-bottom: [Fact],
}

// Which setting changed, for the window's set-setting callback.
export enum SettingKey {
    guide-refresh,
    list-refresh,
    keep-days,
    hardware-decoding,
    audio-language,
    subtitle-language,
    stream-format,
    rewind-buffer,
    resume,
    next-episode,
    sidebar,
    start-on,
    clock,
}

// The current settings, as the controls show them: each choice is the
// index of its option.
export struct SettingValues {
    // Every 6 h, every 12 h, daily, only by hand.
    guide-refresh: int,
    list-refresh: int,
    // 3, 7 or 14 days.
    keep-days: int,
    hardware-decoding: bool,
    // Indexes into the settings data's language lists.
    audio-language: int,
    subtitle-language: int,
    // Automatic, MPEG-TS, HLS.
    stream-format: int,
    // 256 MB, 512 MB, 1 GB, 2 GB.
    rewind-buffer: int,
    resume: bool,
    next-episode: bool,
    // Expanded, icons only.
    sidebar: int,
    // Live TV, where I left off.
    start-on: int,
    // 24-hour, 12-hour.
    clock: int,
}

// One provider's guide in Settings.
export struct GuideStatus {
    name: string,
    // For example "Updated 2 h ago · 18,402 programmes" or "Updating…".
    status: string,
    busy: bool,
    // The time shift, for example "+1 h".
    shift: string,
}

// A place itele keeps files, in Settings' About section.
export struct StorageRow {
    label: string,
    path: string,
    // For example "1.3 GB"; empty while it is measured.
    size: string,
}
