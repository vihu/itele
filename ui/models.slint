// Data the Rust side hands to the screens.

export struct GroupItem {
    name: string,
    count: string,
    // The group's provider, shown when every provider is listed.
    provider: string,
}

export struct ChannelItem {
    number: string,
    name: string,
    group: string,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    archive: string,
    // The programme airing now, empty without a guide.
    now-title: string,
    // How far into it, 0 to 1; below 0 without a guide.
    now-progress: float,
    next-time: string,
    next-title: string,
}

// The selected channel's programme, for the preview and the banner.
export struct ProgrammeInfo {
    title: string,
    // For example "21:00 – 22:00".
    time: string,
    // For example "38 min left".
    left: string,
    description: string,
    progress: float,
}

export struct UpcomingItem {
    time: string,
    title: string,
}

// One programme in the guide grid, positioned in minutes from the window
// start.
export struct GuideCell {
    title: string,
    time: string,
    x: float,
    width: float,
    // 0 ended, 1 on now, 2 upcoming.
    state: int,
    selected: bool,
    // Replayable from the provider's catch-up.
    replay: bool,
}

export struct GuideRow {
    number: string,
    name: string,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    cells: [GuideCell],
}

// A ruler label, in minutes from the window start.
export struct GuideTick {
    x: float,
    label: string,
}

// The selected programme in the guide.
export struct GuideDetails {
    title: string,
    channel: string,
    time: string,
    // For example "Starts in 38 min" or "Ended 2 h ago".
    when: string,
    description: string,
    // On now, so Enter watches the channel.
    live: bool,
    // Ended and replayable, so Enter plays it from the start.
    replay: bool,
}

// A signed-in provider, for the switcher and the settings list.
export struct ProviderItem {
    name: string,
    user: string,
    status: string,
}

// A search result: a channel, a programme, or a section heading.
export struct SearchItem {
    // 0 channel, 1 programme, 2 heading.
    kind: int,
    title: string,
    subtitle: string,
    detail: string,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    // On now: Enter watches it.
    live: bool,
    // Ended and replayable.
    replay: bool,
}
