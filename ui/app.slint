// The itele window: login, the browse screens (Live TV, the guide, search,
// Movies and Series, Settings) beside the sidebar and under the top bar,
// and the fullscreen player.

import "fonts/SchibstedGrotesk.ttf";
import { Theme } from "theme.slint";
import { Button, ButtonKind } from "atoms.slint";
import { LoginScreen } from "login.slint";
import { ChannelItem, GroupItem, LiveTvScreen, ProgrammeInfo, UpcomingItem } from "live-tv.slint";
import { InfoLine, InfoPair, PlayerScreen, PlayerState, TrackItem } from "player.slint";
import { GuideCell, GuideDetails, GuideRow, GuideScreen, GuideTick } from "guide.slint";
import { HomeCard, ProviderItem } from "models.slint";
import { SearchData, SearchItem, SearchScreen } from "search.slint";
import { Shell } from "sidebar.slint";
import { Browse } from "browse.slint";
import { Fact, GuideStatus, ProviderDetails, SettingKey, SettingValues, SettingsData, SettingsScreen } from "settings.slint";
import { PosterItem, VodScreen } from "vod.slint";
import { DetailsScreen, EpisodeItem, SeasonItem, TitleDetails } from "details.slint";
import { FavoritesScreen } from "favorites.slint";
import { HomeScreen } from "home.slint";

export { Shell, SearchData, ChannelItem, HomeCard, Fact, GroupItem, GuideStatus, SettingKey, SettingValues, SettingsData, ProviderItem, SearchItem, GuideCell, GuideDetails, GuideRow, GuideTick, EpisodeItem, InfoLine, InfoPair, PlayerState, PosterItem, ProgrammeInfo, ProviderDetails, SeasonItem, TitleDetails, TrackItem, UpcomingItem }

export enum Screen { login, home, live, favorites, guide, search, movies, series, details, settings, player }


export component AppWindow inherits Window {
    in-out property <Screen> screen: Screen.login;

    // Login and account.
    in-out property <string> login-server;
    in-out property <string> login-username;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    in property <bool> login-can-cancel;
    // The provider of the channel playing, for the info overlay.
    in property <string> provider-name;
    in property <[ProviderItem]> providers;
    // The provider the groups show; -1 shows every provider.
    in property <int> view-index: -1;
    callback login <=> login-screen.submit;
    callback cancel-login <=> login-screen.cancel;
    callback add-provider();
    callback sign-out(int);
    callback view-selected(int);


    // Live TV.
    in property <[GroupItem]> groups;
    in-out property <int> group-index;
    in property <[ChannelItem]> channels;
    in-out property <int> channel-index: -1;
    in property <string> group-title;
    in property <string> status;
    callback group-selected(int);
    callback channel-selected(int);
    callback rows-visible(int, int);

    // Favorites: F or a heart toggles the channel at a row of the listed
    // group; the Favorites screen reorders them and filters by provider.
    in property <int> favorites-filter: -1;
    callback toggle-favorite(int);
    callback move-favorite <=> favorites-screen.reorder;
    callback filter-favorites <=> favorites-screen.filter-selected;
    // Favorite channels, movies and series; the Favorites screen's tab (0
    // channels, 1 movies, 2 series) and its movies or series.
    in property <[int]> favorite-counts: [0, 0, 0];
    in property <int> favorites-tab;
    in property <[PosterItem]> favorite-titles;
    in-out property <int> favorite-title-index;
    callback favorites-tab-selected <=> favorites-screen.tab-selected;
    callback open-favorite-title <=> favorites-screen.open-title;
    callback remove-favorite-title <=> favorites-screen.remove-title;
    callback details-favorite <=> details-screen.favorite;

    // Home's rows: titles left unfinished, favorite channels with what is
    // on, the newest movies; a card opens with its row (1 to 3) and index.
    in property <[HomeCard]> home-unfinished;
    in property <[ChannelItem]> home-channels;
    in property <[PosterItem]> home-movies;
    callback home-open <=> home.open;

    // Guide.
    in property <[GuideRow]> guide-rows;
    in property <int> guide-row;
    in property <[GuideTick]> guide-ticks;
    in property <float> guide-now-x: -1;
    in property <string> guide-day;
    in property <GuideDetails> guide-details;
    out property <length> guide-track-width: guide.track-width;
    callback navigate(int);
    callback guide-move <=> guide.move;
    callback guide-page <=> guide.page;
    callback guide-now <=> guide.now;
    callback guide-enter();
    callback guide-replay <=> guide.replay;
    callback guide-shift(int);
    callback guide-rows-visible <=> guide.rows-visible;
    callback guide-cell-clicked(int, int);
    callback guide-channel-clicked <=> guide.channel-clicked;

    // Scrolls the guide grid to its selected row.
    public function reveal-guide-row() {
        guide.reveal(root.guide-row);
    }

    // Search (SearchData), typed in the top bar: results drop down under
    // the field, and fill the Search screen once it shows.

    // Scrolls the search results to the selected one.
    public function reveal-search-row() {
        if (root.screen == Screen.search) {
            search.reveal(SearchData.index);
        } else {
            browse.reveal(SearchData.index);
        }
    }

    // `/` or Ctrl+K: focuses the search field with the last query selected.
    public function focus-search() {
        browse.focus-search(true);
    }

    // The top bar's clock, for example "21:22".
    in property <string> clock;

    // Movies and Series, which share one screen.
    in property <[GroupItem]> vod-groups;
    in property <int> vod-group-index;
    in property <string> vod-group-title;
    in property <[PosterItem]> vod-items;
    in-out property <int> vod-index;
    in property <string> vod-status;
    in property <string> vod-note;
    in-out property <bool> vod-focus-groups;
    callback vod-group-selected <=> vod.group-selected;
    callback vod-open <=> vod.open;
    callback vod-items-visible <=> vod.items-visible;

    // Scrolls the poster grid to the selected title.
    public function reveal-vod() {
        vod.reveal(root.vod-index);
    }

    // The detail page of a movie or series.
    in property <TitleDetails> details;
    // The rail item the page belongs to: 3 movies, 4 series.
    in property <int> details-rail: 3;
    in property <bool> details-series;
    in property <[SeasonItem]> details-seasons;
    in property <int> details-season-index;
    in property <[EpisodeItem]> details-episodes;
    in-out property <int> details-episode-index;
    callback details-play <=> details-screen.play;
    callback details-restart <=> details-screen.restart;
    callback details-back <=> details-screen.back;
    callback details-season-selected <=> details-screen.season-selected;

    // Scrolls a series' page to the selected season and episode.
    public function reveal-episode() {
        details-screen.reveal-episode();
    }

    // Playback.
    in property <image> frame;
    in property <string> video-note;
    in property <bool> banner-visible: true;
    in property <PlayerState> player;
    in property <ProgrammeInfo> programme;
    in property <[UpcomingItem]> upcoming;
    in-out property <bool> info-visible;
    in property <[InfoLine]> info;
    // The label of the player's back button, for example "Live TV".
    in property <string> player-back: "Live TV";
    out property <length> video-width: screen == Screen.player ? root.width : screen == Screen.guide ? guide.video-width : screen == Screen.favorites ? favorites-screen.video-width : screen == Screen.home ? home.video-width : live.video-width;
    out property <length> video-height: screen == Screen.player ? root.height : screen == Screen.guide ? guide.video-height : screen == Screen.favorites ? favorites-screen.video-height : screen == Screen.home ? home.video-height : live.video-height;
    callback watch();
    callback back <=> player-screen.back;
    callback zap <=> player-screen.zap;
    callback show-banner <=> player-screen.show-banner;
    callback toggle-pause <=> player-screen.toggle-pause;
    callback seek <=> player-screen.seek;
    callback seek-to <=> player-screen.seek-to;
    callback go-live <=> player-screen.go-live;
    callback toggle-mute <=> player-screen.toggle-mute;
    callback change-volume <=> player-screen.change-volume;
    callback set-volume <=> player-screen.set-volume;
    // The player's audio or subtitle menu: 0 audio, 1 subtitles.
    in property <[TrackItem]> track-items;
    in property <int> tracks-kind;
    in-out property <bool> tracks-open;
    in-out property <int> tracks-index;
    callback open-tracks <=> player-screen.open-tracks;
    callback choose-track <=> player-screen.choose-track;
    callback toggle-fullscreen <=> player-screen.toggle-fullscreen;
    callback escape <=> player-screen.escape;

    // Moves keyboard focus to the screen that is showing.
    public function focus-screen() {
        if (root.screen == Screen.login) {
            login-screen.focus-first();
        } else if (root.screen == Screen.home) {
            home.focus-keys();
        } else if (root.screen == Screen.live) {
            live.focus-keys();
        } else if (root.screen == Screen.favorites) {
            favorites-screen.focus-keys();
        } else if (root.screen == Screen.guide) {
            guide.focus-keys();
        } else if (root.screen == Screen.search) {
            browse.focus-search(false);
        } else if (root.screen == Screen.movies || root.screen == Screen.series) {
            vod.focus-keys();
        } else if (root.screen == Screen.details) {
            details-screen.focus-keys();
        } else if (root.screen == Screen.settings) {
            settings-screen.focus-keys();
        } else {
            player-screen.focus-keys();
        }
    }

    // Scrolls the channel list to the selected row.
    public function reveal-current() {
        if (root.screen == Screen.favorites) {
            favorites-screen.reveal(root.channel-index);
        } else {
            live.reveal(root.channel-index);
        }
    }

    title: "itele";
    min-width: 1180px;
    min-height: 720px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: "Schibsted Grotesk";
    default-font-size: Theme.fs-md;

    // The screens beside the sidebar and under the top bar.
    property <bool> browsing: root.screen != Screen.login && root.screen != Screen.player;
    property <int> place: root.screen == Screen.home ? 0 : root.screen == Screen.live ? 1 : root.screen == Screen.favorites ? 7 : root.screen == Screen.guide ? 2 : root.screen == Screen.movies ? 3 : root.screen == Screen.series ? 4 : root.screen == Screen.details ? root.details-rail : root.screen == Screen.settings ? 6 : -1;

    property <ChannelItem> current: root.channel-index >= 0 && root.channel-index < root.channels.length ? root.channels[root.channel-index] : { name: "" };

    function next-provider() {
        if (root.providers.length > 1) {
            root.view-selected(root.view-index + 1 >= root.providers.length ? -1 : root.view-index + 1);
        }
    }

    // Ctrl+B and Ctrl+, anywhere: whatever a screen does not handle reaches
    // here.
    shell-keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text.to-lowercase() == "b") {
                Shell.toggle-sidebar();
                return accept;
            }
            if (event.modifiers.control && event.text == "," && root.browsing) {
                root.navigate(6);
                return accept;
            }
            reject
        }

        browse := Browse {
            visible: root.browsing;
            place: root.place;
            providers: root.providers;
            view-index: root.view-index;
            clock: root.clock;
            searching: root.screen == Screen.search;
            navigate(i) => {
                root.navigate(i);
            }
            view-selected(i) => {
                root.view-selected(i);
            }
            add-provider => {
                root.add-provider();
            }
            escape => {
                if (root.screen == Screen.search) {
                    root.navigate(1);
                } else {
                    root.focus-screen();
                }
            }

            home := HomeScreen {
                visible: root.screen == Screen.home;
                current: root.current;
                programme: root.programme;
                frame: root.screen == Screen.home ? root.frame : @image-url("");
                video-note: root.video-note;
                unfinished: root.home-unfinished;
                channels: root.home-channels;
                movies: root.home-movies;
                watch => {
                    root.watch();
                }
                favorite => {
                    root.toggle-favorite(root.channel-index);
                }
                navigate(i) => {
                    root.navigate(i);
                }
            }

            live := LiveTvScreen {
                visible: root.screen == Screen.live;
                groups: root.groups;
                group-index: root.group-index;
                channels: root.channels;
                channel-index: root.channel-index;
                group-title: root.group-title;
                status: root.status;
                frame: root.screen == Screen.live ? root.frame : @image-url("");
                video-note: root.video-note;
                programme: root.programme;
                upcoming: root.upcoming;
                group-selected(i) => {
                    root.group-selected(i);
                }
                channel-selected(i) => {
                    root.channel-selected(i);
                }
                watch => {
                    root.watch();
                }
                navigate(i) => {
                    root.navigate(i);
                }
                next-provider => {
                    root.next-provider();
                }
                rows-visible(first, count) => {
                    root.rows-visible(first, count);
                }
                favorite(row) => {
                    root.toggle-favorite(row);
                }
            }

            favorites-screen := FavoritesScreen {
                visible: root.screen == Screen.favorites;
                channels: root.channels;
                channel-index: root.channel-index;
                counts: root.favorite-counts;
                providers: root.providers;
                filter: root.favorites-filter;
                tab: root.favorites-tab;
                titles: root.favorite-titles;
                title-index <=> root.favorite-title-index;
                frame: root.screen == Screen.favorites ? root.frame : @image-url("");
                video-note: root.video-note;
                programme: root.programme;
                upcoming: root.upcoming;
                channel-selected(i) => {
                    root.channel-selected(i);
                }
                watch => {
                    root.watch();
                }
                favorite(row) => {
                    root.toggle-favorite(row);
                }
                navigate(i) => {
                    root.navigate(i);
                }
                rows-visible(first, count) => {
                    root.rows-visible(first, count);
                }
            }

            guide := GuideScreen {
                visible: root.screen == Screen.guide;
                rows: root.guide-rows;
                row-index: root.guide-row;
                ticks: root.guide-ticks;
                now-x: root.guide-now-x;
                day: root.guide-day;
                details: root.guide-details;
                frame: root.screen == Screen.guide ? root.frame : @image-url("");
                video-note: root.video-note;
                cell-clicked(row, cell) => {
                    root.guide-cell-clicked(row, cell);
                    guide.focus-keys();
                }
                enter => {
                    root.guide-enter();
                }
                watch => {
                    root.guide-enter();
                }
                earlier => {
                    root.guide-shift(-1);
                }
                later => {
                    root.guide-shift(1);
                }
                favorite => {
                    root.toggle-favorite(root.guide-row);
                }
                navigate(i) => {
                    root.navigate(i);
                }
            }

            search := SearchScreen {
                visible: root.screen == Screen.search;
                navigate(i) => {
                    root.navigate(i);
                }
            }

            vod := VodScreen {
                visible: root.screen == Screen.movies || root.screen == Screen.series;
                title: root.screen == Screen.series ? "Series" : "Movies";
                status: root.vod-status;
                groups: root.vod-groups;
                group-index: root.vod-group-index;
                group-title: root.vod-group-title;
                items: root.vod-items;
                index <=> root.vod-index;
                note: root.vod-note;
                focus-groups <=> root.vod-focus-groups;
                navigate(i) => {
                    root.navigate(i);
                }
                next-provider => {
                    root.next-provider();
                }
            }

            details-screen := DetailsScreen {
                visible: root.screen == Screen.details;
                details: root.details;
                series: root.details-series;
                seasons: root.details-seasons;
                season-index: root.details-season-index;
                episodes: root.details-episodes;
                episode-index <=> root.details-episode-index;
                navigate(i) => {
                    root.navigate(i);
                }
            }

            settings-screen := SettingsScreen {
                visible: root.screen == Screen.settings;
                sign-out(i) => {
                    root.sign-out(i);
                }
                add-provider => {
                    root.add-provider();
                }
                navigate(i) => {
                    root.navigate(i);
                }
            }
        }

        player-screen := PlayerScreen {
            visible: root.screen == Screen.player;
            favorite: root.player.vod ? root.details.favorite : root.current.favorite;
            favorite-clicked => {
                if (root.player.vod) {
                    root.details-favorite();
                } else {
                    root.toggle-favorite(root.channel-index);
                }
            }
            back-label: root.player-back;
            frame: root.screen == Screen.player ? root.frame : @image-url("");
            channel: root.current;
            programme: root.programme;
            state: root.player;
            video-note: root.video-note;
            banner-visible: root.banner-visible;
            info-visible <=> root.info-visible;
            info: root.info;
            tracks: root.track-items;
            tracks-kind: root.tracks-kind;
            tracks-open <=> root.tracks-open;
            tracks-index <=> root.tracks-index;
        }

        login-screen := LoginScreen {
            visible: root.screen == Screen.login;
            server <=> root.login-server;
            username <=> root.login-username;
            password <=> root.login-password;
            error: root.login-error;
            busy: root.login-busy;
            can-cancel: root.login-can-cancel;
        }
    }
}
