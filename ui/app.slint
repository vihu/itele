// The itele window: login, Live TV, the guide, search, Movies and Series,
// and the fullscreen player.

import "fonts/SchibstedGrotesk.ttf";
import { Theme } from "theme.slint";
import { Button, ButtonKind } from "atoms.slint";
import { LoginScreen } from "login.slint";
import { ChannelItem, GroupItem, LiveTvScreen, ProgrammeInfo, UpcomingItem } from "live-tv.slint";
import { InfoLine, InfoPair, PlayerScreen, PlayerState } from "player.slint";
import { GuideCell, GuideDetails, GuideRow, GuideScreen, GuideTick } from "guide.slint";
import { ProviderItem } from "models.slint";
import { SearchItem, SearchScreen } from "search.slint";
import { ProvidersPanel, SwitcherPanel } from "popups.slint";
import { PosterItem, VodScreen } from "vod.slint";

export { ChannelItem, GroupItem, ProviderItem, SearchItem, GuideCell, GuideDetails, GuideRow, GuideTick, InfoLine, InfoPair, PlayerState, PosterItem, ProgrammeInfo, UpcomingItem }

export enum Screen { login, live, guide, search, movies, series, player }


export component AppWindow inherits Window {
    in-out property <Screen> screen: Screen.login;

    // Login and account.
    in-out property <string> login-server;
    in-out property <string> login-username;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    in property <bool> login-can-cancel;
    // The provider of the channel playing, for the info overlay.
    in property <string> provider-name;
    in property <[ProviderItem]> providers;
    // The provider the groups show; -1 shows every provider.
    in property <int> view-index: -1;
    in property <string> view-name;
    callback login();
    callback cancel-login();
    callback add-provider();
    callback sign-out(int);
    callback view-selected(int);

    // Live TV.
    in property <[GroupItem]> groups;
    in-out property <int> group-index;
    in property <[ChannelItem]> channels;
    in-out property <int> channel-index: -1;
    in property <string> group-title;
    in property <string> status;
    in property <string> avatar;
    callback group-selected(int);
    callback channel-selected(int);
    callback rows-visible(int, int);

    // Guide.
    in property <[GuideRow]> guide-rows;
    in property <int> guide-row;
    in property <[GuideTick]> guide-ticks;
    in property <float> guide-now-x: -1;
    in property <string> guide-day;
    in property <GuideDetails> guide-details;
    out property <length> guide-track-width: guide.track-width;
    callback navigate(int);
    callback guide-move(int, int);
    callback guide-page(int);
    callback guide-now();
    callback guide-enter();
    callback guide-replay();
    callback guide-shift(int);
    callback guide-rows-visible(int, int);
    callback guide-cell-clicked(int, int);

    // Scrolls the guide grid to its selected row.
    public function reveal-guide-row() {
        guide.reveal(root.guide-row);
    }

    // Search.
    in-out property <string> search-query;
    in property <[SearchItem]> search-items;
    in property <int> search-index: -1;
    in property <string> search-note;
    callback search-edited(string);
    callback search-picked(int);
    callback search-move(int);

    // Scrolls the search results to the selected one.
    public function reveal-search-row() {
        search.reveal(root.search-index);
    }

    // Movies and Series, which share one screen.
    in property <[GroupItem]> vod-groups;
    in property <int> vod-group-index;
    in property <string> vod-group-title;
    in property <[PosterItem]> vod-items;
    in-out property <int> vod-index;
    in property <string> vod-status;
    in property <string> vod-note;
    in-out property <bool> vod-focus-groups;
    callback vod-group-selected(int);
    callback vod-open(int);
    callback vod-items-visible(int, int);

    // Scrolls the poster grid to the selected title.
    public function reveal-vod() {
        vod.reveal(root.vod-index);
    }

    // Playback.
    in property <image> frame;
    in property <string> video-note;
    in property <bool> banner-visible: true;
    in property <PlayerState> player;
    in property <ProgrammeInfo> programme;
    in property <[UpcomingItem]> upcoming;
    in-out property <bool> info-visible;
    in property <[InfoLine]> info;
    out property <length> video-width: screen == Screen.player ? root.width : screen == Screen.guide ? guide.video-width : live.video-width;
    out property <length> video-height: screen == Screen.player ? root.height : screen == Screen.guide ? guide.video-height : live.video-height;
    callback watch();
    callback back();
    callback zap(int);
    callback show-banner();
    callback toggle-pause();
    callback seek(float);
    callback seek-to(float);
    callback go-live();
    callback toggle-mute();
    callback change-volume(float);
    callback set-volume(float);
    callback cycle-audio();
    callback cycle-subtitles();
    callback toggle-fullscreen();
    callback escape();

    // Moves keyboard focus to the screen that is showing.
    public function focus-screen() {
        if (root.screen == Screen.login) {
            login-screen.focus-first();
        } else if (root.screen == Screen.live) {
            live-keys.focus();
        } else if (root.screen == Screen.guide) {
            guide-keys.focus();
        } else if (root.screen == Screen.search) {
            search.focus-field();
        } else if (root.screen == Screen.movies || root.screen == Screen.series) {
            vod.focus-keys();
        } else {
            player-screen.focus-keys();
        }
    }

    // Scrolls the channel list to the selected row.
    public function reveal-current() {
        live.reveal(root.channel-index);
    }

    title: "itele";
    min-width: 1180px;
    min-height: 720px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: "Schibsted Grotesk";
    default-font-size: Theme.fs-md;

    property <ChannelItem> current: root.channel-index >= 0 && root.channel-index < root.channels.length ? root.channels[root.channel-index] : { name: "" };

    function select(index: int) {
        if (root.channels.length > 0) {
            let target = max(0, min(root.channels.length - 1, index));
            root.channel-selected(target);
            live.reveal(target);
        }
    }

    function next-provider() {
        if (root.providers.length > 1) {
            root.view-selected(root.view-index + 1 >= root.providers.length ? -1 : root.view-index + 1);
        }
    }

    function select-group(index: int) {
        if (root.groups.length > 0) {
            let target = max(0, min(root.groups.length - 1, index));
            root.group-selected(target);
            live.reveal-group(target);
        }
    }

    live-keys := FocusScope {
        visible: root.screen == Screen.live;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.select(root.channel-index - 1);
            } else if (event.text == Key.DownArrow) {
                root.select(root.channel-index + 1);
            } else if (event.text == Key.PageUp) {
                root.select(root.channel-index - 10);
            } else if (event.text == Key.PageDown) {
                root.select(root.channel-index + 10);
            } else if (event.text == Key.Home) {
                root.select(0);
            } else if (event.text == Key.End) {
                root.select(root.channels.length - 1);
            } else if (event.text == Key.LeftArrow) {
                root.select-group(root.group-index - 1);
            } else if (event.text == Key.RightArrow) {
                root.select-group(root.group-index + 1);
            } else if (event.text == Key.Return && root.channel-index >= 0) {
                root.watch();
            } else if (event.text.to-lowercase() == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && event.text.to-lowercase() == "k")) {
                root.navigate(5);
            } else if (event.text.to-lowercase() == "p") {
                root.next-provider();
            } else {
                return reject;
            }
            accept
        }
        live := LiveTvScreen {
            groups: root.groups;
            group-index: root.group-index;
            channels: root.channels;
            channel-index: root.channel-index;
            group-title: root.group-title;
            status: root.status;
            avatar: root.avatar;
            frame: root.screen == Screen.live ? root.frame : @image-url("");
            video-note: root.video-note;
            programme: root.programme;
            upcoming: root.upcoming;
            group-selected(i) => {
                root.select-group(i);
                live-keys.focus();
            }
            channel-selected(i) => {
                root.channel-selected(i);
                live-keys.focus();
            }
            watch => {
                root.watch();
            }
            view-name: root.view-name;
            settings-clicked => {
                settings.show();
            }
            navigate(i) => {
                root.navigate(i);
            }
            switch-clicked => {
                switcher.show();
            }
            rows-visible(first, count) => {
                root.rows-visible(first, count);
            }
        }
    }

    guide-keys := FocusScope {
        visible: root.screen == Screen.guide;
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.UpArrow) {
                root.guide-move(0, -1);
            } else if (event.text == Key.DownArrow) {
                root.guide-move(0, 1);
            } else if (event.text == Key.LeftArrow) {
                root.guide-move(-1, 0);
            } else if (event.text == Key.RightArrow) {
                root.guide-move(1, 0);
            } else if (event.text == Key.PageUp) {
                root.guide-page(-1);
            } else if (event.text == Key.PageDown) {
                root.guide-page(1);
            } else if (key == "n" || event.text == Key.Home) {
                root.guide-now();
            } else if (event.text == Key.Return) {
                root.guide-enter();
            } else if (event.text == Key.Escape || key == "g") {
                root.navigate(1);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else {
                return reject;
            }
            accept
        }
        guide := GuideScreen {
            rows: root.guide-rows;
            row-index: root.guide-row;
            ticks: root.guide-ticks;
            now-x: root.guide-now-x;
            day: root.guide-day;
            details: root.guide-details;
            frame: root.screen == Screen.guide ? root.frame : @image-url("");
            video-note: root.video-note;
            avatar: root.avatar;
            rows-visible(first, count) => {
                root.guide-rows-visible(first, count);
            }
            cell-clicked(row, cell) => {
                root.guide-cell-clicked(row, cell);
                guide-keys.focus();
            }
            watch => {
                root.guide-enter();
            }
            replay => {
                root.guide-replay();
            }
            earlier => {
                root.guide-shift(-1);
            }
            later => {
                root.guide-shift(1);
            }
            navigate(i) => {
                root.navigate(i);
            }
            settings-clicked => {
                settings.show();
            }
        }
    }

    search-keys := FocusScope {
        visible: root.screen == Screen.search;
        // Arrows, Enter and Esc drive the results; everything else types.
        capture-key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.search-move(-1);
            } else if (event.text == Key.DownArrow) {
                root.search-move(1);
            } else if (event.text == Key.Return) {
                root.search-picked(root.search-index);
            } else if (event.text == Key.Escape) {
                root.navigate(1);
            } else {
                return reject;
            }
            accept
        }
        search := SearchScreen {
            query <=> root.search-query;
            items: root.search-items;
            index: root.search-index;
            note: root.search-note;
            avatar: root.avatar;
            edited(text) => {
                root.search-edited(text);
            }
            picked(i) => {
                root.search-picked(i);
            }
            navigate(i) => {
                root.navigate(i);
            }
            settings-clicked => {
                settings.show();
            }
        }
    }

    vod := VodScreen {
        visible: root.screen == Screen.movies || root.screen == Screen.series;
        title: root.screen == Screen.series ? "Series" : "Movies";
        rail-active: root.screen == Screen.series ? 4 : 3;
        status: root.vod-status;
        avatar: root.avatar;
        view-name: root.view-name;
        groups: root.vod-groups;
        group-index: root.vod-group-index;
        group-title: root.vod-group-title;
        items: root.vod-items;
        index <=> root.vod-index;
        note: root.vod-note;
        focus-groups <=> root.vod-focus-groups;
        group-selected(i) => {
            root.vod-group-selected(i);
        }
        open(i) => {
            root.vod-open(i);
        }
        items-visible(first, count) => {
            root.vod-items-visible(first, count);
        }
        navigate(i) => {
            root.navigate(i);
        }
        next-provider => {
            root.next-provider();
        }
        settings-clicked => {
            settings.show();
        }
        switch-clicked => {
            switcher.show();
        }
    }

    player-screen := PlayerScreen {
        visible: root.screen == Screen.player;
        frame: root.screen == Screen.player ? root.frame : @image-url("");
        channel: root.current;
        programme: root.programme;
        state: root.player;
        video-note: root.video-note;
        banner-visible: root.banner-visible;
        info-visible <=> root.info-visible;
        info: root.info;
        back => {
            root.back();
        }
        escape => {
            root.escape();
        }
        zap(delta) => {
            root.zap(delta);
        }
        show-banner => {
            root.show-banner();
        }
        toggle-pause => {
            root.toggle-pause();
        }
        seek(seconds) => {
            root.seek(seconds);
        }
        seek-to(fraction) => {
            root.seek-to(fraction);
        }
        set-volume(percent) => {
            root.set-volume(percent);
        }
        change-volume(delta) => {
            root.change-volume(delta);
        }
        go-live => {
            root.go-live();
        }
        toggle-mute => {
            root.toggle-mute();
        }
        cycle-audio => {
            root.cycle-audio();
        }
        cycle-subtitles => {
            root.cycle-subtitles();
        }
        toggle-fullscreen => {
            root.toggle-fullscreen();
        }
    }

    login-screen := LoginScreen {
        visible: root.screen == Screen.login;
        server <=> root.login-server;
        username <=> root.login-username;
        password <=> root.login-password;
        error: root.login-error;
        busy: root.login-busy;
        can-cancel: root.login-can-cancel;
        submit => {
            root.login();
        }
        cancel => {
            root.cancel-login();
        }
    }

    // Provider switcher, under the groups column's switcher button.
    switcher := PopupWindow {
        x: 88px;
        y: 128px;
        width: 300px;
        close-policy: close-on-click-outside;
        SwitcherPanel {
            providers: root.providers;
            view-index: root.view-index;
            selected(i) => {
                switcher.close();
                root.view-selected(i);
            }
        }
    }

    // Signed-in providers, each with sign out, and Add provider.
    settings := PopupWindow {
        x: 84px;
        y: root.height - self.height - 16px;
        width: 360px;
        close-policy: close-on-click-outside;
        ProvidersPanel {
            providers: root.providers;
            sign-out(i) => {
                settings.close();
                root.sign-out(i);
            }
            add-provider => {
                settings.close();
                root.add-provider();
            }
        }
    }
}
