// Settings: the sections column and the section showing.
// Layout: .ai-docs/mockups/07-settings.html.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Hint } from "atoms.slint";
import { Fact, GuideStatus, ProviderDetails, SettingKey, SettingValues } from "models.slint";
import { PanelHeader, SectionItem } from "settings-controls.slint";
import { ProviderBlock } from "settings-providers.slint";
import { SettingsData } from "settings-data.slint";
import { GuidePanel } from "settings-guide.slint";
import { InterfacePanel, PlaybackPanel } from "settings-playback.slint";
import { AboutPanel } from "settings-about.slint";

export { Fact, GuideStatus, ProviderDetails, SettingKey, SettingValues, SettingsData }

export component SettingsScreen inherits Rectangle {
    // The section showing: 0 providers, 1 guide, 2 playback, 3 interface,
    // 4 about.
    in-out property <int> section;
    changed section => {
        if (root.section == 4) {
            SettingsData.measure-storage();
        }
    }
    callback sign-out(int);
    callback add-provider();
    callback navigate(int);

    public function focus-keys() {
        keys.focus();
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.Escape) {
                root.navigate(1);
            } else if (event.text == Key.UpArrow) {
                root.section = max(0, root.section - 1);
            } else if (event.text == Key.DownArrow) {
                root.section = min(4, root.section + 1);
            } else if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else {
                return reject;
            }
            accept
        }

        HorizontalLayout {
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    // Sections.
                    Rectangle {
                        width: 250px;
                        VerticalLayout {
                            padding-top: 24px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 2px;
                            alignment: start;
                            VerticalLayout {
                                padding-left: 12px;
                                padding-bottom: 22px;
                                spacing: 2px;
                                Text {
                                    text: "Settings";
                                    color: Theme.text;
                                    font-size: Theme.fs-2xl;
                                    font-weight: 800;
                                }
                                Text {
                                    text: "itele " + SettingsData.version;
                                    color: Theme.text-3;
                                    font-size: Theme.fs-sm;
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/tv.svg");
                                text: "Providers";
                                count: SettingsData.providers.length;
                                selected: root.section == 0;
                                clicked => {
                                    root.section = 0;
                                    keys.focus();
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/guide.svg");
                                text: "Guide";
                                selected: root.section == 1;
                                clicked => {
                                    root.section = 1;
                                    keys.focus();
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/play.svg");
                                text: "Playback";
                                selected: root.section == 2;
                                clicked => {
                                    root.section = 2;
                                    keys.focus();
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/panel-close.svg");
                                text: "Interface";
                                selected: root.section == 3;
                                clicked => {
                                    root.section = 3;
                                    keys.focus();
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/info.svg");
                                text: "About";
                                selected: root.section == 4;
                                clicked => {
                                    root.section = 4;
                                    keys.focus();
                                }
                            }
                        }
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.line;
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding-left: 48px;
                            padding-right: 48px;
                            padding-top: 30px;
                            padding-bottom: 64px;
                            alignment: start;
                            if root.section == 0: VerticalLayout {
                                max-width: 820px;
                                PanelHeader {
                                    title: "Providers";
                                    description: "Each provider keeps its own channels, movies, series and guide. Search and the guide span all of them.";
                                    action: "Add provider";
                                    icon: @image-url("icons/plus.svg");
                                    clicked => {
                                        root.add-provider();
                                    }
                                }
                                for provider[i] in SettingsData.providers: ProviderBlock {
                                    provider: provider;
                                    rename(name) => {
                                        SettingsData.rename(i, name);
                                    }
                                    refresh => {
                                        SettingsData.refresh-provider(i);
                                    }
                                    sign-out => {
                                        root.sign-out(i);
                                    }
                                    done => {
                                        keys.focus();
                                    }
                                }
                            }
                            if root.section == 1: GuidePanel {
                                max-width: 820px;
                            }
                            if root.section == 2: PlaybackPanel {
                                max-width: 820px;
                            }
                            if root.section == 3: InterfacePanel {
                                max-width: 820px;
                            }
                            if root.section == 4: AboutPanel {
                                max-width: 820px;
                            }
                        }
                    }
                }
                // Shortcut hints.
                Rectangle {
                    height: 44px;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 22px;
                        alignment: start;
                        Hint {
                            keys: ["↑", "↓"];
                            label: "Section";
                        }
                        Hint {
                            keys: ["Tab"];
                            label: "Next field";
                        }
                        Hint {
                            keys: ["Esc"];
                            label: "Back";
                        }
                    }
                }
            }
        }
    }
}
