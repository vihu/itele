// Settings: the sections column and, for now, the Providers section.
// Layout: .ai-docs/mockups/07-settings.html.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind, Hint } from "atoms.slint";
import { Fact, GuideStatus, ProviderDetails, SettingKey, SettingValues } from "models.slint";
import { Sidebar } from "sidebar.slint";
import { SectionItem, Segmented, SettingRow, Stepper } from "settings-controls.slint";
import { ProviderBlock } from "settings-providers.slint";

export { Fact, GuideStatus, ProviderDetails, SettingKey, SettingValues }

// A section's title, what it is for, and its main button.
component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> action;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    spacing: 24px;
    padding-bottom: 10px;
    VerticalLayout {
        spacing: 4px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-xl;
            font-weight: 700;
        }
        Text {
            text: root.description;
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
    if root.action != "": VerticalLayout {
        alignment: end;
        Button {
            kind: ButtonKind.secondary;
            text: root.action;
            icon: root.icon;
            has-icon: true;
            enabled: root.enabled;
            clicked => {
                root.clicked();
            }
        }
    }
}

// One provider's guide: how it is, its time shift, and Refresh.
component GuideRowView inherits VerticalLayout {
    in property <GuideStatus> status;
    callback shift(int);
    callback refresh();
    HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 20px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.status.name;
                color: Theme.text;
                font-size: Theme.fs-md;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.status.status;
                color: root.status.busy ? Theme.accent : Theme.text-3;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Stepper {
                value: root.status.shift;
                step(sign) => {
                    root.shift(sign);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                kind: ButtonKind.secondary;
                text: "Refresh";
                enabled: !root.status.busy;
                clicked => {
                    root.refresh();
                }
            }
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.line;
    }
}

// What the Settings screen shows and what it asks for; the Rust side
// fills and answers it.
export global SettingsData {
    in property <[ProviderDetails]> providers;
    in property <[GuideStatus]> guide-rows;
    in property <SettingValues> values;
    in property <string> version;
    callback rename(int, string);
    callback refresh-provider(int);
    callback refresh-guide(int);
    callback refresh-all();
    callback shift-guide(int, int);
    callback set-setting(SettingKey, int);
}

export component SettingsScreen inherits Rectangle {
    // The section showing: 0 providers, 1 guide.
    in-out property <int> section;
    callback sign-out(int);
    callback add-provider();
    callback navigate(int);

    public function focus-keys() {
        keys.focus();
    }

    property <[string]> intervals: ["Every 6 h", "Every 12 h", "Daily", "Only by hand"];

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.Escape) {
                root.navigate(1);
            } else if (event.text == Key.UpArrow) {
                root.section = max(0, root.section - 1);
            } else if (event.text == Key.DownArrow) {
                root.section = min(1, root.section + 1);
            } else if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else {
                return reject;
            }
            accept
        }

        HorizontalLayout {
            Sidebar {
                active: 6;
                navigate(i) => {
                    root.navigate(i);
                }
            }
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    // Sections.
                    Rectangle {
                        width: 250px;
                        VerticalLayout {
                            padding-top: 24px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 2px;
                            alignment: start;
                            VerticalLayout {
                                padding-left: 12px;
                                padding-bottom: 22px;
                                spacing: 2px;
                                Text {
                                    text: "Settings";
                                    color: Theme.text;
                                    font-size: Theme.fs-2xl;
                                    font-weight: 800;
                                }
                                Text {
                                    text: "itele " + SettingsData.version;
                                    color: Theme.text-3;
                                    font-size: Theme.fs-sm;
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/tv.svg");
                                text: "Providers";
                                count: SettingsData.providers.length;
                                selected: root.section == 0;
                                clicked => {
                                    root.section = 0;
                                    keys.focus();
                                }
                            }
                            SectionItem {
                                icon: @image-url("icons/guide.svg");
                                text: "Guide";
                                selected: root.section == 1;
                                clicked => {
                                    root.section = 1;
                                    keys.focus();
                                }
                            }
                        }
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.line;
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding-left: 48px;
                            padding-right: 48px;
                            padding-top: 30px;
                            padding-bottom: 64px;
                            alignment: start;
                            if root.section == 0: VerticalLayout {
                                max-width: 820px;
                                PanelHeader {
                                    title: "Providers";
                                    description: "Each provider keeps its own channels, movies, series and guide. Search and the guide span all of them.";
                                    action: "Add provider";
                                    icon: @image-url("icons/plus.svg");
                                    clicked => {
                                        root.add-provider();
                                    }
                                }
                                for provider[i] in SettingsData.providers: ProviderBlock {
                                    provider: provider;
                                    rename(name) => {
                                        SettingsData.rename(i, name);
                                    }
                                    refresh => {
                                        SettingsData.refresh-provider(i);
                                    }
                                    sign-out => {
                                        root.sign-out(i);
                                    }
                                    done => {
                                        keys.focus();
                                    }
                                }
                            }
                            if root.section == 1: VerticalLayout {
                                max-width: 820px;
                                PanelHeader {
                                    title: "Guide";
                                    description: "itele downloads each provider's guide in the background, at start and while it stays open.";
                                    action: "Refresh all now";
                                    icon: @image-url("icons/refresh.svg");
                                    clicked => {
                                        SettingsData.refresh-all();
                                    }
                                }
                                SettingRow {
                                    title: "Refresh the guide";
                                    description: "How old a guide may get before it is downloaded again. Large guides can take a minute.";
                                    Segmented {
                                        options: root.intervals;
                                        selected: SettingsData.values.guide-refresh;
                                        chosen(i) => {
                                            SettingsData.set-setting(SettingKey.guide-refresh, i);
                                        }
                                    }
                                }
                                SettingRow {
                                    title: "Refresh channel and title lists";
                                    description: "Channels, movies and series, from each provider. The account is checked every time.";
                                    Segmented {
                                        options: root.intervals;
                                        selected: SettingsData.values.list-refresh;
                                        chosen(i) => {
                                            SettingsData.set-setting(SettingKey.list-refresh, i);
                                        }
                                    }
                                }
                                SettingRow {
                                    title: "Keep past programmes";
                                    description: "For catch-up. Providers rarely keep more than a week. Applies at the next refresh.";
                                    Segmented {
                                        options: ["3 days", "7 days", "14 days"];
                                        selected: SettingsData.values.keep-days;
                                        chosen(i) => {
                                            SettingsData.set-setting(SettingKey.keep-days, i);
                                        }
                                    }
                                }
                                Text {
                                    text: "Per provider";
                                    color: Theme.text-3;
                                    font-size: Theme.fs-sm;
                                    font-weight: 700;
                                    height: 56px;
                                    vertical-alignment: bottom;
                                }
                                for row[i] in SettingsData.guide-rows: GuideRowView {
                                    status: row;
                                    shift(sign) => {
                                        SettingsData.shift-guide(i, sign);
                                    }
                                    refresh => {
                                        SettingsData.refresh-guide(i);
                                    }
                                }
                                Text {
                                    text: "Shift the times when a provider's guide is an hour or two off; the guide downloads again.";
                                    color: Theme.text-3;
                                    font-size: Theme.fs-sm;
                                    wrap: word-wrap;
                                    height: 40px;
                                    vertical-alignment: bottom;
                                }
                            }
                        }
                    }
                }
                // Shortcut hints.
                Rectangle {
                    height: 44px;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 22px;
                        alignment: start;
                        Hint {
                            keys: ["↑", "↓"];
                            label: "Section";
                        }
                        Hint {
                            keys: ["Tab"];
                            label: "Next field";
                        }
                        Hint {
                            keys: ["Esc"];
                            label: "Back";
                        }
                    }
                }
            }
        }
    }
}
