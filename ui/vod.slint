// Movies and Series: icon rail, groups column, and a virtualized poster
// grid. One screen serves both; the window fills it with either.
// Layout: .ai-docs/mockups/05-movies.html, with the groups column of Live
// TV instead of chips (TASK-003).

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Hint } from "atoms.slint";
import { GroupItem, PosterItem } from "models.slint";
import { Rail } from "rail.slint";
import { GroupsColumn } from "groups.slint";

export { PosterItem }

component PosterCard inherits Rectangle {
    in property <PosterItem> item;
    in property <bool> selected;
    callback clicked();

    VerticalLayout {
        spacing: 0px;
        alignment: start;
        Rectangle {
            height: self.width * 1.5;
            border-radius: Theme.radius-md;
            clip: true;
            background: @linear-gradient(180deg, root.item.tint 0%, Theme.surface-1 100%);
            if !root.item.has-poster: Text {
                x: 14px;
                y: parent.height - self.height - 14px;
                width: parent.width - 28px;
                text: root.item.title;
                color: Theme.text;
                font-size: Theme.fs-lg;
                font-weight: 800;
                wrap: word-wrap;
                overflow: elide;
                max-height: parent.height - 28px;
            }
            if root.item.has-poster: Image {
                width: 100%;
                height: 100%;
                source: root.item.poster;
                image-fit: cover;
            }
            if root.selected: Rectangle {
                border-radius: Theme.radius-md;
                border-width: 3px;
                border-color: Theme.accent;
            }
        }
        Rectangle {
            height: 10px;
        }
        Text {
            text: root.item.title;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: Theme.fs-sm;
            font-weight: 600;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            height: 18px;
            Text {
                text: root.item.detail;
                color: Theme.text-3;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.item.rating != "": HorizontalLayout {
                spacing: 3px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("icons/star.svg");
                        width: 11px;
                        height: 11px;
                        colorize: Theme.accent;
                    }
                }
                Text {
                    text: root.item.rating;
                    color: Theme.text-2;
                    font-size: Theme.fs-xs;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component VodScreen inherits Rectangle {
    // "Movies" or "Series".
    in property <string> title;
    // The rail item to highlight: 3 movies, 4 series.
    in property <int> rail-active;
    in property <string> status;
    in property <string> avatar;
    in property <string> view-name;
    in property <[GroupItem]> groups;
    in property <int> group-index;
    in property <string> group-title;
    in property <[PosterItem]> items;
    in-out property <int> index;
    // Shown instead of the grid while it is empty, for example "Loading…".
    in property <string> note;
    callback group-selected(int);
    callback open(int);
    callback navigate(int);
    callback next-provider();
    callback settings-clicked();
    callback switch-clicked();
    // Titles `first` to `first + count` are on screen, for lazy posters.
    callback items-visible(int, int);

    // Keyboard focus is in the groups column rather than the grid.
    in-out property <bool> focus-groups;

    property <length> gap: 22px;
    property <length> min-card: 156px;
    property <int> columns: max(1, floor((list.visible-width + root.gap) / (root.min-card + root.gap)));
    property <length> card-width: (list.visible-width - (root.columns - 1) * root.gap) / root.columns;
    property <length> row-height: root.card-width * 1.5 + 72px;
    property <int> row-count: ceil(root.items.length / root.columns);
    property <int> first-row: max(0, floor(-list.content-y / root.row-height));
    property <int> visible-rows: ceil(list.visible-height / root.row-height) + 1;

    changed first-row => {
        root.report();
    }
    changed columns => {
        root.report();
    }
    changed visible-rows => {
        root.report();
    }

    function report() {
        root.items-visible(root.first-row * root.columns, root.visible-rows * root.columns);
    }

    public function focus-keys() {
        keys.focus();
    }

    // Scrolls the grid so title `index` is visible, and the groups so the
    // selected group is.
    public function reveal(index: int) {
        let row = floor(max(0, index) / root.columns);
        if (row * root.row-height < -list.content-y) {
            list.content-y = -row * root.row-height;
        } else if ((row + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((row + 1) * root.row-height - list.visible-height);
        }
        groups.reveal(root.group-index);
    }

    function select(target: int) {
        if (root.items.length > 0) {
            root.index = max(0, min(root.items.length - 1, target));
            root.reveal(root.index);
        }
    }

    function select-group(target: int) {
        if (root.groups.length > 0) {
            let group = max(0, min(root.groups.length - 1, target));
            root.group-selected(group);
            groups.reveal(group);
        }
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else if (key == "p") {
                root.next-provider();
            } else if (root.focus-groups) {
                if (event.text == Key.UpArrow) {
                    root.select-group(root.group-index - 1);
                } else if (event.text == Key.DownArrow) {
                    root.select-group(root.group-index + 1);
                } else if (event.text == Key.PageUp) {
                    root.select-group(root.group-index - 10);
                } else if (event.text == Key.PageDown) {
                    root.select-group(root.group-index + 10);
                } else if ((event.text == Key.RightArrow || event.text == Key.Return) && root.items.length > 0) {
                    root.focus-groups = false;
                    root.select(root.index);
                } else if (event.text == Key.Escape) {
                    root.navigate(1);
                } else {
                    return reject;
                }
            } else if (event.text == Key.UpArrow) {
                if (root.index >= root.columns) {
                    root.select(root.index - root.columns);
                }
            } else if (event.text == Key.DownArrow) {
                if (floor(root.index / root.columns) < root.row-count - 1) {
                    root.select(root.index + root.columns);
                }
            } else if (event.text == Key.LeftArrow) {
                if (mod(root.index, root.columns) == 0) {
                    root.focus-groups = true;
                } else {
                    root.select(root.index - 1);
                }
            } else if (event.text == Key.RightArrow) {
                if (mod(root.index, root.columns) < root.columns - 1) {
                    root.select(root.index + 1);
                }
            } else if (event.text == Key.PageUp) {
                root.select(root.index - root.columns * max(1, root.visible-rows - 1));
            } else if (event.text == Key.PageDown) {
                root.select(root.index + root.columns * max(1, root.visible-rows - 1));
            } else if (event.text == Key.Home) {
                root.select(0);
            } else if (event.text == Key.End) {
                root.select(root.items.length - 1);
            } else if (event.text == Key.Return && root.index >= 0 && root.index < root.items.length) {
                root.open(root.index);
            } else if (event.text == Key.Escape) {
                root.focus-groups = true;
            } else {
                return reject;
            }
            accept
        }

        HorizontalLayout {
            Rail {
                avatar: root.avatar;
                active: root.rail-active;
                navigate(i) => {
                    root.navigate(i);
                }
                settings-clicked => {
                    root.settings-clicked();
                }
            }
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    groups := GroupsColumn {
                        title: root.title;
                        status: root.status;
                        view-name: root.view-name;
                        groups: root.groups;
                        group-index: root.group-index;
                        focused: root.focus-groups;
                        group-selected(i) => {
                            root.focus-groups = true;
                            root.group-selected(i);
                            keys.focus();
                        }
                        switch-clicked => {
                            root.switch-clicked();
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            padding-left: 32px;
                            padding-right: 32px;
                            padding-top: 26px;
                            padding-bottom: 18px;
                            spacing: 10px;
                            Text {
                                text: root.group-title;
                                color: Theme.text;
                                font-size: Theme.fs-xl;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.group-index < 0 || root.group-index >= root.groups.length ? ""
                                    : root.groups[root.group-index].count + (root.items.length == 1 ? " title" : " titles");
                                color: Theme.text-3;
                                font-size: Theme.fs-sm;
                                vertical-alignment: bottom;
                                horizontal-stretch: 1;
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 20px;
                                list := ListView {
                                    for r in root.row-count: HorizontalLayout {
                                        height: root.row-height;
                                        spacing: root.gap;
                                        alignment: start;
                                        for c in root.columns: PosterCard {
                                            property <int> i: r * root.columns + c;
                                            width: root.card-width;
                                            visible: self.i < root.items.length;
                                            item: root.items[self.i];
                                            selected: !root.focus-groups && self.i == root.index;
                                            clicked => {
                                                root.focus-groups = false;
                                                root.index = self.i;
                                                keys.focus();
                                                root.open(self.i);
                                            }
                                        }
                                    }
                                }
                            }
                            if root.items.length == 0 && root.note != "": Text {
                                text: root.note;
                                color: Theme.text-3;
                                font-size: Theme.fs-md;
                            }
                        }
                    }
                }
                // Shortcut hints.
                Rectangle {
                    height: 44px;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 22px;
                        alignment: start;
                        if root.focus-groups: Hint {
                            keys: ["↑", "↓"];
                            label: "Group";
                        }
                        if root.focus-groups: Hint {
                            keys: ["→"];
                            label: "Titles";
                        }
                        if !root.focus-groups: Hint {
                            keys: ["↑", "↓", "←", "→"];
                            label: "Move";
                        }
                        if !root.focus-groups: Hint {
                            keys: ["Enter"];
                            label: "Open";
                        }
                        if !root.focus-groups: Hint {
                            keys: ["Esc"];
                            label: "Groups";
                        }
                        Hint {
                            keys: ["P"];
                            label: "Provider";
                        }
                    }
                }
            }
        }
    }
}
