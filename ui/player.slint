// Fullscreen player: channel banner, a control bar after mpv-modernz, and
// the stream info overlay (`i`). Layout: .ai-docs/mockups/04-player.html
// and the user's modernz reference (TASK-002).

import { Theme } from "theme.slint";
import { Button, ButtonKind, ChannelLogo, LiveMarker, Tag } from "atoms.slint";
import { ChannelItem, ProgrammeInfo } from "models.slint";
import { IconButton, Track } from "controls.slint";
import { TrackItem, TrackMenu } from "track-menu.slint";

export { TrackItem }

export struct PlayerState {
    paused: bool,
    muted: bool,
    volume: int,
    // Time behind the live edge, empty when live.
    behind: string,
    // Playhead within the cached window, 0 to 1.
    position: float,
    audio: string,
    subtitles: string,
    fullscreen: bool,
    // Playing a past programme from catch-up rather than live.
    replay: bool,
    // Playing a movie or an episode.
    vod: bool,
    // In replay and VOD, for example "12:34 / 1:00:00".
    time: string,
}

// One "label: value" pair in the info overlay.
export struct InfoPair {
    label: string,
    value: string,
}

// One line of the info overlay; section heads are not indented.
export struct InfoLine {
    indent: bool,
    pairs: [InfoPair],
}

export component PlayerScreen inherits Rectangle {
    in property <image> frame;
    in property <ChannelItem> channel;
    in property <ProgrammeInfo> programme;
    in property <PlayerState> state;
    in property <string> video-note;
    in property <bool> banner-visible;
    in-out property <bool> info-visible;
    in property <[InfoLine]> info;
    in property <string> back-label: "Live TV";
    // The channel, or the movie or series, is a favorite.
    in property <bool> favorite;
    callback back();
    // H or the heart: what is playing joins the favorites, or leaves.
    callback favorite-clicked();
    callback escape();
    callback zap(int);
    callback show-banner();
    callback toggle-pause();
    callback seek(float);
    callback seek-to(float);
    callback go-live();
    callback toggle-mute();
    callback set-volume(float);
    callback change-volume(float);
    // The open track menu: 0 audio, 1 subtitles.
    in property <[TrackItem]> tracks;
    in property <int> tracks-kind;
    in-out property <bool> tracks-open;
    in-out property <int> tracks-index;
    callback open-tracks(int);
    callback choose-track(int, int);
    callback toggle-fullscreen();

    public function focus-keys() {
        keys.focus();
    }

    background: #000;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (root.tracks-open) {
                if (event.text == Key.UpArrow) {
                    root.tracks-index = max(0, root.tracks-index - 1);
                } else if (event.text == Key.DownArrow) {
                    root.tracks-index = min(root.tracks.length - 1, root.tracks-index + 1);
                } else if (event.text == Key.Return && root.tracks-index >= 0 && root.tracks-index < root.tracks.length) {
                    root.tracks-open = false;
                    root.choose-track(root.tracks-kind, root.tracks[root.tracks-index].id);
                } else if (event.text == Key.Escape || (key == "a" && root.tracks-kind == 0) || (key == "s" && root.tracks-kind == 1)) {
                    root.tracks-open = false;
                } else if (key == "a") {
                    root.open-tracks(0);
                } else if (key == "s") {
                    root.open-tracks(1);
                }
                root.show-banner();
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.PageUp) {
                root.zap(-1);
            } else if (event.text == Key.DownArrow || event.text == Key.PageDown) {
                root.zap(1);
            } else if (event.text == Key.LeftArrow) {
                root.seek(-10);
            } else if (event.text == Key.RightArrow) {
                root.seek(10);
            } else if (key == " " || key == "k") {
                root.toggle-pause();
            } else if (key == "l" || event.text == Key.End) {
                root.go-live();
            } else if (key == "m") {
                root.toggle-mute();
            } else if (key == "+" || key == "=") {
                root.change-volume(5);
            } else if (key == "-") {
                root.change-volume(-5);
            } else if (key == "a") {
                root.open-tracks(0);
            } else if (key == "s") {
                root.open-tracks(1);
            } else if (key == "f") {
                root.toggle-fullscreen();
            } else if (key == "i") {
                root.info-visible = !root.info-visible;
            } else if (key == "h") {
                root.favorite-clicked();
            } else if (event.text == Key.Escape && root.info-visible) {
                root.info-visible = false;
            } else if (event.text == Key.Escape) {
                root.escape();
            } else if (event.text == Key.Backspace) {
                root.back();
            } else {
                root.show-banner();
                return reject;
            }
            root.show-banner();
            accept
        }
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.frame;
        image-fit: fill;
    }
    // Under the banner, so its buttons get their clicks first.
    TouchArea {
        mouse-cursor: default;
        moved => {
            root.show-banner();
        }
        clicked => {
            root.show-banner();
        }
        double-clicked => {
            root.toggle-fullscreen();
        }
    }
    if root.video-note != "": Text {
        text: root.video-note;
        color: Theme.text-2;
        font-size: Theme.fs-lg;
        font-weight: 600;
    }

    // Top bar.
    Rectangle {
        y: 0;
        height: 120px;
        opacity: root.banner-visible ? 1 : 0;
        animate opacity { duration: 200ms; }
        background: @linear-gradient(180deg, #08090cbf 0%, #08090c00 100%);
        HorizontalLayout {
            padding: 22px;
            padding-left: 24px;
            alignment: start;
            VerticalLayout {
                alignment: start;
                Button {
                    kind: ButtonKind.secondary;
                    text: root.back-label;
                    icon: @image-url("icons/arrow-left.svg");
                    has-icon: true;
                    clicked => {
                        root.back();
                    }
                }
            }
        }
    }

    // Stream info, after mpv's stats page.
    if root.info-visible: Rectangle {
        x: 24px;
        y: 84px;
        width: info-text.preferred-width;
        height: info-text.preferred-height;
        border-radius: Theme.radius-md;
        background: #000000c7;
        info-text := VerticalLayout {
            padding: 24px;
            padding-top: 12px;
            spacing: 5px;
            for line in root.info: HorizontalLayout {
                alignment: start;
                padding-left: line.indent ? 28px : 0px;
                padding-top: line.indent ? 0px : 12px;
                spacing: 22px;
                for pair in line.pairs: HorizontalLayout {
                    alignment: start;
                    spacing: 7px;
                    Text {
                        text: pair.label + ":";
                        color: Theme.text;
                        font-size: Theme.fs-md;
                        font-weight: 700;
                    }
                    Text {
                        text: pair.value;
                        color: Theme.text;
                        font-size: Theme.fs-md;
                    }
                }
            }
        }
    }

    // Channel banner and the control bar.
    Rectangle {
        y: parent.height - self.height;
        height: 270px;
        opacity: root.banner-visible ? 1 : 0;
        animate opacity { duration: 200ms; }
        background: @linear-gradient(0deg, #000000e6 0%, #000000b3 45%, #00000000 100%);
        VerticalLayout {
            padding-bottom: 10px;
            spacing: 0px;
            alignment: end;
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    if !root.state.vod: VerticalLayout {
                        alignment: center;
                        ChannelLogo {
                            width: 64px;
                            height: 40px;
                            short: root.channel.short;
                            tint: root.channel.tint;
                            logo: root.channel.logo;
                            has-logo: root.channel.has-logo;
                        }
                    }
                    if !root.state.vod: Text {
                        text: root.channel.number;
                        color: Theme.text-2;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if !root.state.vod && root.channel.archive != "": VerticalLayout {
                        alignment: center;
                        Tag {
                            text: root.channel.archive;
                            on-image: true;
                        }
                    }
                    if root.state.audio != "": VerticalLayout {
                        alignment: center;
                        Tag {
                            text: root.state.audio;
                            on-image: true;
                        }
                    }
                    if root.state.subtitles != "": VerticalLayout {
                        alignment: center;
                        Tag {
                            text: "Subtitles: " + root.state.subtitles;
                            on-image: true;
                        }
                    }
                }
                Text {
                    text: root.programme.title != "" ? root.programme.title : root.channel.name;
                    color: Theme.text;
                    font-size: 34px;
                    font-weight: 800;
                    overflow: elide;
                }
                Text {
                    text: root.state.vod ? root.programme.time
                        : root.programme.title != "" ? root.channel.name + "  ·  " + root.programme.time + "  ·  " + root.programme.left
                        : root.channel.group;
                    color: Theme.text-2;
                    font-size: Theme.fs-md;
                    font-weight: 500;
                    overflow: elide;
                }
            }

            // Timeline over the cached window; the right end is live.
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Track {
                    value: root.state.position;
                    changed(fraction) => {
                        root.seek-to(fraction);
                        root.show-banner();
                    }
                }
            }

            // One row of controls, every one centred on the row's middle.
            Rectangle {
                height: 60px;
                HorizontalLayout {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: 44px;
                    alignment: start;
                    spacing: 4px;
                    IconButton {
                        icon: @image-url("icons/audio.svg");
                        active: root.tracks-open && root.tracks-kind == 0;
                        clicked => {
                            if (root.tracks-open && root.tracks-kind == 0) {
                                root.tracks-open = false;
                            } else {
                                root.open-tracks(0);
                            }
                            root.show-banner();
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/captions.svg");
                        active: root.state.subtitles != "" || (root.tracks-open && root.tracks-kind == 1);
                        clicked => {
                            if (root.tracks-open && root.tracks-kind == 1) {
                                root.tracks-open = false;
                            } else {
                                root.open-tracks(1);
                            }
                            root.show-banner();
                        }
                    }
                    IconButton {
                        icon: root.state.muted ? @image-url("icons/mute.svg") : @image-url("icons/volume.svg");
                        active: root.state.muted;
                        clicked => {
                            root.toggle-mute();
                            root.show-banner();
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Track {
                            width: 88px;
                            handle: 12px;
                            fill: Theme.text;
                            value: root.state.muted ? 0 : min(1, root.state.volume / 100);
                            changed(fraction) => {
                                root.set-volume(fraction * 100);
                                root.show-banner();
                            }
                        }
                    }
                    Rectangle {
                        width: 14px;
                    }
                    if root.state.replay: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.state.time;
                            color: Theme.text;
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Go live";
                            color: replay-live.has-hover ? Theme.accent-hover : Theme.accent;
                            font-size: Theme.fs-md;
                            font-weight: 700;
                            vertical-alignment: center;
                            replay-live := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.go-live();
                                    root.show-banner();
                                }
                            }
                        }
                    }
                    if root.state.vod: Text {
                        text: root.state.time;
                        color: Theme.text;
                        font-size: Theme.fs-md;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if !root.state.replay && !root.state.vod && root.state.behind == "": LiveMarker {
                        alignment: center;
                    }
                    if !root.state.replay && !root.state.vod && root.state.behind != "": HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "-" + root.state.behind;
                            color: Theme.text;
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Go live";
                            color: go-live.has-hover ? Theme.accent-hover : Theme.accent;
                            font-size: Theme.fs-md;
                            font-weight: 700;
                            vertical-alignment: center;
                            go-live := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.go-live();
                                    root.show-banner();
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: 52px;
                    alignment: center;
                    spacing: 18px;
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/back.svg");
                            badge: "10";
                            clicked => {
                                root.seek(-10);
                                root.show-banner();
                            }
                        }
                    }
                    IconButton {
                        big: true;
                        icon: root.state.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                        clicked => {
                            root.toggle-pause();
                            root.show-banner();
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/forward.svg");
                            badge: "10";
                            clicked => {
                                root.seek(10);
                                root.show-banner();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    x: parent.width - self.width - 12px;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: 44px;
                    alignment: end;
                    spacing: 4px;
                    IconButton {
                        icon: root.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                        active: root.favorite;
                        clicked => {
                            root.favorite-clicked();
                            root.show-banner();
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/info.svg");
                        active: root.info-visible;
                        clicked => {
                            root.info-visible = !root.info-visible;
                            root.show-banner();
                        }
                    }
                    IconButton {
                        icon: root.state.fullscreen ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                        clicked => {
                            root.toggle-fullscreen();
                        }
                    }
                }
            }
        }
    }

    // The audio or subtitle menu, above its button.
    if root.tracks-open: TrackMenu {
        tracks: root.tracks;
        kind: root.tracks-kind;
        index: root.tracks-index;
        menu-x: root.tracks-kind == 0 ? 12px : 60px;
        close => {
            root.tracks-open = false;
            root.show-banner();
        }
        chosen(id) => {
            root.tracks-open = false;
            root.choose-track(root.tracks-kind, id);
            root.show-banner();
        }
    }
}
