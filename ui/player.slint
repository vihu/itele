// Fullscreen player: channel banner, a control bar after mpv-modernz, and
// the stream info overlay (`i`). Layout: .ai-docs/mockups/04-player.html
// and the user's modernz reference (TASK-002).

import { Theme } from "theme.slint";
import { Button, ButtonKind, ChannelLogo, LiveMarker, Tag } from "atoms.slint";
import { ChannelItem, ProgrammeInfo } from "live-tv.slint";

export struct PlayerState {
    paused: bool,
    muted: bool,
    volume: int,
    // Time behind the live edge, empty when live.
    behind: string,
    // Playhead within the cached window, 0 to 1.
    position: float,
    audio: string,
    subtitles: string,
    fullscreen: bool,
}

// One "label: value" pair in the info overlay.
export struct InfoPair {
    label: string,
    value: string,
}

// One line of the info overlay; section heads are not indented.
export struct InfoLine {
    indent: bool,
    pairs: [InfoPair],
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> big;
    in property <string> badge;
    callback clicked();
    width: big ? 52px : 44px;
    height: self.width;
    border-radius: self.width / 2;
    background: touch.has-hover ? #ffffff1f : transparent;
    Image {
        source: root.icon;
        width: root.big ? 34px : 24px;
        height: self.width;
        colorize: root.active ? Theme.accent : Theme.text;
    }
    if root.badge != "": Text {
        y: (parent.height - self.height) / 2 + 1px;
        text: root.badge;
        color: Theme.text;
        font-size: 8.5px;
        font-weight: 800;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A thin track with a round handle; reports where it was pressed or dragged.
component Track inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    in property <length> handle: 14px;
    callback changed(float);
    height: 18px;
    property <length> thickness: touch.has-hover ? 6px : 4px;
    Rectangle {
        y: (parent.height - root.thickness) / 2;
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: #ffffff4d;
    }
    Rectangle {
        x: 0;
        y: (parent.height - root.thickness) / 2;
        width: parent.width * root.value;
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: root.fill;
    }
    Rectangle {
        x: parent.width * root.value - root.handle / 2;
        y: (parent.height - root.handle) / 2;
        width: root.handle;
        height: root.handle;
        border-radius: root.handle / 2;
        background: root.fill;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.changed(max(0, min(1, self.mouse-x / self.width)));
            }
        }
        moved => {
            if (self.pressed) {
                root.changed(max(0, min(1, self.mouse-x / self.width)));
            }
        }
    }
}

export component PlayerScreen inherits Rectangle {
    in property <image> frame;
    in property <ChannelItem> channel;
    in property <ProgrammeInfo> programme;
    in property <PlayerState> state;
    in property <string> video-note;
    in property <bool> banner-visible;
    in property <bool> info-visible;
    in property <[InfoLine]> info;
    callback back();
    callback toggle-pause();
    callback seek(float);
    callback seek-to(float);
    callback go-live();
    callback toggle-mute();
    callback set-volume(float);
    callback cycle-audio();
    callback cycle-subtitles();
    callback toggle-info();
    callback toggle-fullscreen();

    background: #000;
    Image {
        width: 100%;
        height: 100%;
        source: root.frame;
        image-fit: fill;
    }
    if root.video-note != "": Text {
        text: root.video-note;
        color: Theme.text-2;
        font-size: Theme.fs-lg;
        font-weight: 600;
    }

    // Top bar.
    Rectangle {
        y: 0;
        height: 120px;
        opacity: root.banner-visible ? 1 : 0;
        animate opacity { duration: 200ms; }
        background: @linear-gradient(180deg, #08090cbf 0%, #08090c00 100%);
        HorizontalLayout {
            padding: 22px;
            padding-left: 24px;
            alignment: start;
            VerticalLayout {
                alignment: start;
                Button {
                    kind: ButtonKind.secondary;
                    text: "Live TV";
                    icon: @image-url("icons/arrow-left.svg");
                    has-icon: true;
                    clicked => {
                        root.back();
                    }
                }
            }
        }
    }

    // Stream info, after mpv's stats page.
    if root.info-visible: Rectangle {
        x: 24px;
        y: 84px;
        width: info-text.preferred-width;
        height: info-text.preferred-height;
        border-radius: Theme.radius-md;
        background: #000000c7;
        info-text := VerticalLayout {
            padding: 24px;
            padding-top: 12px;
            spacing: 5px;
            for line in root.info: HorizontalLayout {
                alignment: start;
                padding-left: line.indent ? 28px : 0px;
                padding-top: line.indent ? 0px : 12px;
                spacing: 22px;
                for pair in line.pairs: HorizontalLayout {
                    alignment: start;
                    spacing: 7px;
                    Text {
                        text: pair.label + ":";
                        color: Theme.text;
                        font-size: Theme.fs-md;
                        font-weight: 700;
                    }
                    Text {
                        text: pair.value;
                        color: Theme.text;
                        font-size: Theme.fs-md;
                    }
                }
            }
        }
    }

    // Channel banner and the control bar.
    Rectangle {
        y: parent.height - self.height;
        height: 270px;
        opacity: root.banner-visible ? 1 : 0;
        animate opacity { duration: 200ms; }
        background: @linear-gradient(0deg, #000000e6 0%, #000000b3 45%, #00000000 100%);
        VerticalLayout {
            padding-bottom: 10px;
            spacing: 0px;
            alignment: end;
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        ChannelLogo {
                            width: 64px;
                            height: 40px;
                            short: root.channel.short;
                            tint: root.channel.tint;
                            logo: root.channel.logo;
                            has-logo: root.channel.has-logo;
                        }
                    }
                    Text {
                        text: root.channel.number;
                        color: Theme.text-2;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if root.channel.archive != "": VerticalLayout {
                        alignment: center;
                        Tag {
                            text: root.channel.archive;
                            on-image: true;
                        }
                    }
                    if root.state.audio != "": VerticalLayout {
                        alignment: center;
                        Tag {
                            text: root.state.audio;
                            on-image: true;
                        }
                    }
                    if root.state.subtitles != "": VerticalLayout {
                        alignment: center;
                        Tag {
                            text: "Subtitles: " + root.state.subtitles;
                            on-image: true;
                        }
                    }
                }
                Text {
                    text: root.programme.title != "" ? root.programme.title : root.channel.name;
                    color: Theme.text;
                    font-size: 34px;
                    font-weight: 800;
                    overflow: elide;
                }
                Text {
                    text: root.programme.title != ""
                        ? root.channel.name + "  ·  " + root.programme.time + "  ·  " + root.programme.left
                        : root.channel.group;
                    color: Theme.text-2;
                    font-size: Theme.fs-md;
                    font-weight: 500;
                    overflow: elide;
                }
            }

            // Timeline over the cached window; the right end is live.
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Track {
                    value: root.state.position;
                    changed(fraction) => {
                        root.seek-to(fraction);
                    }
                }
            }

            // One row of same-size controls.
            Rectangle {
                height: 60px;
                HorizontalLayout {
                    x: 12px;
                    width: self.preferred-width;
                    alignment: start;
                    spacing: 4px;
                    IconButton {
                        icon: @image-url("icons/audio.svg");
                        clicked => {
                            root.cycle-audio();
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/captions.svg");
                        active: root.state.subtitles != "";
                        clicked => {
                            root.cycle-subtitles();
                        }
                    }
                    IconButton {
                        icon: root.state.muted ? @image-url("icons/mute.svg") : @image-url("icons/volume.svg");
                        active: root.state.muted;
                        clicked => {
                            root.toggle-mute();
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Track {
                            width: 88px;
                            handle: 12px;
                            fill: Theme.text;
                            value: root.state.muted ? 0 : min(1, root.state.volume / 100);
                            changed(fraction) => {
                                root.set-volume(fraction * 100);
                            }
                        }
                    }
                    Rectangle {
                        width: 14px;
                    }
                    if root.state.behind == "": LiveMarker {
                        alignment: center;
                    }
                    if root.state.behind != "": HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "-" + root.state.behind;
                            color: Theme.text;
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Go live";
                            color: go-live.has-hover ? Theme.accent-hover : Theme.accent;
                            font-size: Theme.fs-md;
                            font-weight: 700;
                            vertical-alignment: center;
                            go-live := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.go-live();
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    width: self.preferred-width;
                    alignment: center;
                    spacing: 18px;
                    IconButton {
                        icon: @image-url("icons/back.svg");
                        badge: "10";
                        clicked => {
                            root.seek(-10);
                        }
                    }
                    IconButton {
                        big: true;
                        icon: root.state.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                        clicked => {
                            root.toggle-pause();
                        }
                    }
                    IconButton {
                        icon: @image-url("icons/forward.svg");
                        badge: "10";
                        clicked => {
                            root.seek(10);
                        }
                    }
                }
                HorizontalLayout {
                    x: parent.width - self.width - 12px;
                    width: self.preferred-width;
                    alignment: end;
                    spacing: 4px;
                    IconButton {
                        icon: @image-url("icons/info.svg");
                        active: root.info-visible;
                        clicked => {
                            root.toggle-info();
                        }
                    }
                    IconButton {
                        icon: root.state.fullscreen ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                        clicked => {
                            root.toggle-fullscreen();
                        }
                    }
                }
            }
        }
    }
}
