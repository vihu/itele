// Rows of the browse lists: a group, and a channel with now and next.

import { Theme } from "theme.slint";
import { ChannelLogo, ProviderTag } from "atoms.slint";
import { ChannelItem, GroupItem } from "models.slint";

export component GroupRow inherits Rectangle {
    in property <GroupItem> item;
    in property <bool> selected;
    // Keyboard focus is on this row.
    in property <bool> ring;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-2 : transparent;
    border-width: ring ? 1px : 0px;
    border-color: Theme.accent-line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.item.name;
            color: root.selected ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-2;
            font-size: Theme.fs-md;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.favorites: VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/heart-fill.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.accent;
            }
        }
        if root.item.provider != "": Text {
            text: root.item.provider;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            overflow: elide;
            max-width: 90px;
        }
        Text {
            text: root.item.count;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component ChannelRow inherits Rectangle {
    in property <ChannelItem> item;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    // The heart: adds the channel to the favorites, or removes it.
    callback heart-clicked();
    height: 74px;
    border-radius: Theme.radius-md;
    background: selected ? Theme.surface-2 : touch.has-hover || heart.has-hover ? Theme.surface-1 : transparent;
    border-width: selected ? 1px : 0px;
    border-color: Theme.accent-line;
    opacity: item.gone ? 0.45 : 1;
    // Under the row's content, so the heart takes its own clicks.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            width: 36px;
            text: root.item.number;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            ChannelLogo {
                short: root.item.short;
                tint: root.item.tint;
                logo: root.item.logo;
                has-logo: root.item.has-logo;
            }
        }
        info := VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            property <bool> guide: root.item.now-title != "";
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    color: info.guide ? Theme.text-2 : Theme.text;
                    font-size: info.guide ? Theme.fs-sm : Theme.fs-md;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.item.provider != "": ProviderTag {
                    text: root.item.provider;
                    hue: root.item.hue;
                    max-width: 120px;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: info.guide ? root.item.now-title : root.item.group;
                color: info.guide ? Theme.text : Theme.text-3;
                font-size: info.guide ? Theme.fs-md : Theme.fs-sm;
                font-weight: info.guide ? 600 : 400;
                overflow: elide;
            }
            if root.item.now-progress >= 0: VerticalLayout {
                padding-top: 5px;
                Rectangle {
                    height: 3px;
                    max-width: 280px;
                    border-radius: 1.5px;
                    background: #ffffff29;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.item.now-progress;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
            }
        }
        // A narrow list (the sidebar expanded, a small window) keeps the
        // channel and programme names readable instead.
        if root.item.next-title != "" && root.width >= 560px: HorizontalLayout {
            width: 200px;
            spacing: 6px;
            Text {
                text: root.item.next-time;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.item.next-title;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        if root.item.archive != "": VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/catchup.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.text-3;
            }
        }
        // Filled for a favorite; an outline to add one, on hover.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                Image {
                    source: root.item.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                    width: 16px;
                    height: 16px;
                    colorize: root.item.favorite ? Theme.accent : heart.has-hover ? Theme.text : Theme.text-3;
                    opacity: root.item.favorite || touch.has-hover || heart.has-hover ? 1 : 0;
                }
                heart := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.heart-clicked();
                    }
                }
            }
        }
    }
}
