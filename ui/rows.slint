// Rows of the browse lists: a group, and a channel with now and next.

import { Theme } from "theme.slint";
import { ChannelLogo } from "atoms.slint";
import { ChannelItem, GroupItem } from "models.slint";

export component GroupRow inherits Rectangle {
    in property <GroupItem> item;
    in property <bool> selected;
    // Keyboard focus is on this row.
    in property <bool> ring;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-2 : transparent;
    border-width: ring ? 1px : 0px;
    border-color: Theme.accent-line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.item.name;
            color: root.selected ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-2;
            font-size: Theme.fs-md;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.provider != "": Text {
            text: root.item.provider;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            overflow: elide;
            max-width: 90px;
        }
        Text {
            text: root.item.count;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component ChannelRow inherits Rectangle {
    in property <ChannelItem> item;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    height: 74px;
    border-radius: Theme.radius-md;
    background: selected ? Theme.surface-2 : touch.has-hover ? Theme.surface-1 : transparent;
    border-width: selected ? 1px : 0px;
    border-color: Theme.accent-line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            width: 36px;
            text: root.item.number;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            ChannelLogo {
                short: root.item.short;
                tint: root.item.tint;
                logo: root.item.logo;
                has-logo: root.item.has-logo;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            property <bool> guide: root.item.now-title != "";
            Text {
                text: root.item.name;
                color: parent.guide ? Theme.text-2 : Theme.text;
                font-size: parent.guide ? Theme.fs-sm : Theme.fs-md;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: parent.guide ? root.item.now-title : root.item.group;
                color: parent.guide ? Theme.text : Theme.text-3;
                font-size: parent.guide ? Theme.fs-md : Theme.fs-sm;
                font-weight: parent.guide ? 600 : 400;
                overflow: elide;
            }
            if root.item.now-progress >= 0: VerticalLayout {
                padding-top: 5px;
                Rectangle {
                    height: 3px;
                    max-width: 280px;
                    border-radius: 1.5px;
                    background: #ffffff29;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.item.now-progress;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
            }
        }
        // A narrow list (the sidebar expanded, a small window) keeps the
        // channel and programme names readable instead.
        if root.item.next-title != "" && root.width >= 560px: HorizontalLayout {
            width: 200px;
            spacing: 6px;
            Text {
                text: root.item.next-time;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.item.next-title;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        if root.item.archive != "": VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/catchup.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.text-3;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}
