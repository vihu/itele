// Live TV: icon rail, groups, channel list, and the live preview.
// Layout: .ai-docs/mockups/02-live-tv.html.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Hint } from "atoms.slint";
import { ChannelItem, GroupItem, ProgrammeInfo, UpcomingItem } from "models.slint";
import { ChannelPreview } from "preview.slint";
import { ChannelRow } from "rows.slint";
import { GroupsColumn } from "groups.slint";

export { ChannelItem, GroupItem, ProgrammeInfo, UpcomingItem }

export component LiveTvScreen inherits Rectangle {
    in property <[GroupItem]> groups;
    in property <int> group-index;
    in property <[ChannelItem]> channels;
    in property <int> channel-index;
    in property <string> group-title;
    in property <string> status;
    in property <image> frame;
    in property <string> video-note;
    in property <ProgrammeInfo> programme;
    in property <[UpcomingItem]> upcoming;
    out property <length> video-width: preview.video-width;
    out property <length> video-height: preview.video-height;
    callback group-selected(int);
    callback channel-selected(int);
    callback watch();
    callback navigate(int);
    callback next-provider();
    // F or a heart: the channel at a row joins the favorites, or leaves.
    callback favorite(int);
    // Rows `first` to `first + count` are on screen, for lazy logos.
    callback rows-visible(int, int);

    property <int> first-visible: floor(-list.content-y / 74px);
    changed first-visible => {
        root.rows-visible(root.first-visible, ceil(list.visible-height / 74px) + 1);
    }

    property <ChannelItem> current: root.channel-index >= 0 && root.channel-index < root.channels.length ? root.channels[root.channel-index] : { name: "" };

    public function focus-keys() {
        keys.focus();
    }

    function select(index: int) {
        if (root.channels.length > 0) {
            let target = max(0, min(root.channels.length - 1, index));
            root.channel-selected(target);
            root.reveal(target);
        }
    }

    function select-group(index: int) {
        if (root.groups.length > 0) {
            let target = max(0, min(root.groups.length - 1, index));
            root.group-selected(target);
            groups.reveal(target);
        }
    }

    // Scrolls the channel list so row `index` is visible.
    public function reveal(index: int) {
        if (index * 74px < -list.content-y) {
            list.content-y = -index * 74px;
        } else if ((index + 1) * 74px > -list.content-y + list.visible-height) {
            list.content-y = -((index + 1) * 74px - list.visible-height);
        }
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.UpArrow) {
                root.select(root.channel-index - 1);
            } else if (event.text == Key.DownArrow) {
                root.select(root.channel-index + 1);
            } else if (event.text == Key.PageUp) {
                root.select(root.channel-index - 10);
            } else if (event.text == Key.PageDown) {
                root.select(root.channel-index + 10);
            } else if (event.text == Key.Home) {
                root.select(0);
            } else if (event.text == Key.End) {
                root.select(root.channels.length - 1);
            } else if (event.text == Key.LeftArrow) {
                root.select-group(root.group-index - 1);
            } else if (event.text == Key.RightArrow) {
                root.select-group(root.group-index + 1);
            } else if (event.text == Key.Return && root.channel-index >= 0) {
                root.watch();
            } else if (key == "f" && root.channel-index >= 0) {
                root.favorite(root.channel-index);
            } else if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else if (key == "p") {
                root.next-provider();
            } else {
                return reject;
            }
            accept
        }
    }
    HorizontalLayout {
        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                groups := GroupsColumn {
                    title: "Live TV";
                    status: root.status;
                    groups: root.groups;
                    group-index: root.group-index;
                    group-selected(i) => {
                        root.select-group(i);
                        keys.focus();
                    }
                }
                // Channels.
                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 26px;
                        padding-bottom: 14px;
                        spacing: 10px;
                        Text {
                            text: root.group-title;
                            color: Theme.text;
                            font-size: Theme.fs-xl;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.channels.length + " channels";
                            color: Theme.text-3;
                            font-size: Theme.fs-sm;
                            vertical-alignment: bottom;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        list := ListView {
                            for channel[i] in root.channels: ChannelRow {
                                item: channel;
                                selected: i == root.channel-index;
                                clicked => {
                                    root.channel-selected(i);
                                    keys.focus();
                                }
                                double-clicked => {
                                    root.channel-selected(i);
                                    root.watch();
                                }
                                heart-clicked => {
                                    root.favorite(i);
                                }
                            }
                        }
                    }
                }
                preview := ChannelPreview {
                    frame: root.frame;
                    video-note: root.video-note;
                    current: root.current;
                    programme: root.programme;
                    upcoming: root.upcoming;
                    watch => {
                        root.watch();
                    }
                    favorite => {
                        root.favorite(root.channel-index);
                    }
                }
            }
            // Shortcut hints.
            Rectangle {
                height: 44px;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 24px;
                    spacing: 22px;
                    alignment: start;
                    Hint {
                        keys: ["↑", "↓"];
                        label: "Channel";
                    }
                    Hint {
                        keys: ["←", "→"];
                        label: "Group";
                    }
                    Hint {
                        keys: ["PgUp", "PgDn"];
                        label: "Page";
                    }
                    Hint {
                        keys: ["Enter"];
                        label: "Watch";
                    }
                    Hint {
                        keys: ["F"];
                        label: "Favorite";
                    }
                    Hint {
                        keys: ["P"];
                        label: "Provider";
                    }
                }
            }
        }
    }
}
