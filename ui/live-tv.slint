// Live TV: icon rail, groups, channel list, and the live preview.
// Layout: .ai-docs/mockups/02-live-tv.html.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind, ChannelLogo, Hint, LiveMarker, Tag } from "atoms.slint";

export struct GroupItem {
    name: string,
    count: string,
    // The group's provider, shown when every provider is listed.
    provider: string,
}

export struct ChannelItem {
    number: string,
    name: string,
    group: string,
    short: string,
    tint: color,
    logo: image,
    has-logo: bool,
    archive: string,
}

component RailItem inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    width: 48px;
    height: 44px;
    border-radius: Theme.radius-md;
    background: active ? Theme.surface-3 : touch.has-hover ? Theme.surface-2 : transparent;
    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Rail inherits Rectangle {
    in property <string> avatar;
    callback settings-clicked();
    width: 76px;
    background: Theme.surface-1;
    VerticalLayout {
        padding-top: 22px;
        padding-bottom: 16px;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            padding-bottom: 22px;
            Text {
                text: "i";
                color: Theme.text;
                font-size: 22px;
                font-weight: 800;
            }
            Text {
                text: ".";
                color: Theme.accent;
                font-size: 22px;
                font-weight: 800;
            }
        }
        for item in [
            { icon: @image-url("icons/home.svg"), active: false },
            { icon: @image-url("icons/tv.svg"), active: true },
            { icon: @image-url("icons/guide.svg"), active: false },
            { icon: @image-url("icons/film.svg"), active: false },
            { icon: @image-url("icons/series.svg"), active: false },
            { icon: @image-url("icons/search.svg"), active: false },
        ]: HorizontalLayout {
            alignment: center;
            RailItem {
                icon: item.icon;
                active: item.active;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: center;
            padding-bottom: 8px;
            RailItem {
                icon: @image-url("icons/settings.svg");
                clicked => {
                    root.settings-clicked();
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: Theme.surface-4;
                Text {
                    text: root.avatar;
                    color: Theme.text;
                    font-size: Theme.fs-sm;
                    font-weight: 700;
                }
            }
        }
    }
}

component GroupRow inherits Rectangle {
    in property <GroupItem> item;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-2 : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.item.name;
            color: root.selected ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-2;
            font-size: Theme.fs-md;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.provider != "": Text {
            text: root.item.provider;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            overflow: elide;
            max-width: 90px;
        }
        Text {
            text: root.item.count;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ChannelRow inherits Rectangle {
    in property <ChannelItem> item;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    height: 74px;
    border-radius: Theme.radius-md;
    background: selected ? Theme.surface-2 : touch.has-hover ? Theme.surface-1 : transparent;
    border-width: selected ? 1px : 0px;
    border-color: Theme.accent-line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            width: 36px;
            text: root.item.number;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            ChannelLogo {
                short: root.item.short;
                tint: root.item.tint;
                logo: root.item.logo;
                has-logo: root.item.has-logo;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.fs-md;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.group;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
        }
        if root.item.archive != "": VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/catchup.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.text-3;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

export component LiveTvScreen inherits Rectangle {
    in property <[GroupItem]> groups;
    in property <int> group-index;
    in property <[ChannelItem]> channels;
    in property <int> channel-index;
    in property <string> group-title;
    in property <string> status;
    in property <string> avatar;
    in property <string> view-name;
    in property <image> frame;
    in property <string> video-note;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;
    callback group-selected(int);
    callback channel-selected(int);
    callback watch();
    callback settings-clicked();
    callback switch-clicked();
    // Rows `first` to `first + count` are on screen, for lazy logos.
    callback rows-visible(int, int);

    property <int> first-visible: floor(-list.content-y / 74px);
    changed first-visible => {
        root.rows-visible(root.first-visible, ceil(list.visible-height / 74px) + 1);
    }

    property <ChannelItem> current: root.channel-index >= 0 && root.channel-index < root.channels.length ? root.channels[root.channel-index] : { name: "" };

    // Scrolls the channel list so row `index` is visible.
    public function reveal(index: int) {
        if (index * 74px < -list.content-y) {
            list.content-y = -index * 74px;
        } else if ((index + 1) * 74px > -list.content-y + list.visible-height) {
            list.content-y = -((index + 1) * 74px - list.visible-height);
        }
    }

    background: Theme.bg;
    HorizontalLayout {
        Rail {
            avatar: root.avatar;
            settings-clicked => {
                root.settings-clicked();
            }
        }
        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                // Groups.
                Rectangle {
                    width: 250px;
                    VerticalLayout {
                        padding-top: 24px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;
                        VerticalLayout {
                            padding-left: 12px;
                            spacing: 2px;
                            Text {
                                text: "Live TV";
                                color: Theme.text;
                                font-size: Theme.fs-2xl;
                                font-weight: 800;
                            }
                            Text {
                                text: root.status;
                                color: Theme.text-3;
                                font-size: Theme.fs-sm;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            height: 10px;
                        }
                        // Provider switcher.
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-sm;
                            background: switch-touch.has-hover ? Theme.surface-3 : Theme.surface-2;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text {
                                    text: root.view-name;
                                    color: Theme.text;
                                    font-size: Theme.fs-md;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/down.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.text-2;
                                    }
                                }
                            }
                            switch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.switch-clicked();
                                }
                            }
                        }
                        Rectangle {
                            height: 16px;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for group[i] in root.groups: GroupRow {
                                item: group;
                                selected: i == root.group-index;
                                clicked => {
                                    root.group-selected(i);
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }
                // Channels.
                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 26px;
                        padding-bottom: 14px;
                        spacing: 10px;
                        Text {
                            text: root.group-title;
                            color: Theme.text;
                            font-size: Theme.fs-xl;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.channels.length + " channels";
                            color: Theme.text-3;
                            font-size: Theme.fs-sm;
                            vertical-alignment: bottom;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        list := ListView {
                            for channel[i] in root.channels: ChannelRow {
                                item: channel;
                                selected: i == root.channel-index;
                                clicked => {
                                    root.channel-selected(i);
                                }
                                double-clicked => {
                                    root.channel-selected(i);
                                    root.watch();
                                }
                            }
                        }
                    }
                }
                // Preview.
                Rectangle {
                    width: 460px;
                    background: Theme.surface-1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 0px;
                        alignment: start;
                        video := Rectangle {
                            height: self.width * 9 / 16;
                            border-radius: Theme.radius-md;
                            clip: true;
                            background: #000;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.frame;
                                image-fit: fill;
                            }
                            if root.video-note != "": Text {
                                text: root.video-note;
                                color: Theme.text-2;
                                font-size: Theme.fs-sm;
                                font-weight: 600;
                            }
                            if root.current.name != "": Rectangle {
                                x: 12px;
                                y: 12px;
                                width: marker.preferred-width + 16px;
                                height: 22px;
                                border-radius: 5px;
                                background: Theme.on-image;
                                marker := LiveMarker {
                                    x: 8px;
                                    height: parent.height;
                                }
                            }
                        }
                        Rectangle {
                            height: 22px;
                        }
                        Text {
                            text: root.current.name;
                            color: Theme.text;
                            font-size: Theme.fs-2xl;
                            font-weight: 800;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 6px;
                        }
                        Text {
                            text: root.current.name == "" ? "" : root.current.number + "  ·  " + root.current.group;
                            color: Theme.text-2;
                            font-size: Theme.fs-md;
                            font-weight: 500;
                        }
                        Rectangle {
                            height: 16px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            if root.current.archive != "": Tag {
                                text: root.current.archive;
                            }
                        }
                        Rectangle {
                            height: 22px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            if root.current.name != "": Button {
                                kind: ButtonKind.primary;
                                text: "Watch";
                                hint: "Enter";
                                icon: @image-url("icons/play.svg");
                                has-icon: true;
                                clicked => {
                                    root.watch();
                                }
                            }
                        }
                    }
                }
            }
            // Shortcut hints.
            Rectangle {
                height: 44px;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 24px;
                    spacing: 22px;
                    alignment: start;
                    Hint {
                        keys: ["↑", "↓"];
                        label: "Channel";
                    }
                    Hint {
                        keys: ["←", "→"];
                        label: "Group";
                    }
                    Hint {
                        keys: ["PgUp", "PgDn"];
                        label: "Page";
                    }
                    Hint {
                        keys: ["Enter"];
                        label: "Watch";
                    }
                    Hint {
                        keys: ["P"];
                        label: "Provider";
                    }
                }
            }
        }
    }
}
