// Live TV: icon rail, groups, channel list, and the live preview.
// Layout: .ai-docs/mockups/02-live-tv.html.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind, ChannelLogo, Hint, LiveMarker, Tag } from "atoms.slint";
import { ChannelItem, GroupItem, ProgrammeInfo, UpcomingItem } from "models.slint";
import { Rail } from "rail.slint";
import { ChannelRow } from "rows.slint";
import { GroupsColumn } from "groups.slint";

export { ChannelItem, GroupItem, ProgrammeInfo, UpcomingItem }

export component LiveTvScreen inherits Rectangle {
    in property <[GroupItem]> groups;
    in property <int> group-index;
    in property <[ChannelItem]> channels;
    in property <int> channel-index;
    in property <string> group-title;
    in property <string> status;
    in property <string> avatar;
    in property <string> view-name;
    in property <image> frame;
    in property <string> video-note;
    in property <ProgrammeInfo> programme;
    in property <[UpcomingItem]> upcoming;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;
    callback group-selected(int);
    callback channel-selected(int);
    callback watch();
    callback settings-clicked();
    callback switch-clicked();
    callback navigate(int);
    callback next-provider();
    // Rows `first` to `first + count` are on screen, for lazy logos.
    callback rows-visible(int, int);

    property <int> first-visible: floor(-list.content-y / 74px);
    changed first-visible => {
        root.rows-visible(root.first-visible, ceil(list.visible-height / 74px) + 1);
    }

    property <ChannelItem> current: root.channel-index >= 0 && root.channel-index < root.channels.length ? root.channels[root.channel-index] : { name: "" };

    public function focus-keys() {
        keys.focus();
    }

    function select(index: int) {
        if (root.channels.length > 0) {
            let target = max(0, min(root.channels.length - 1, index));
            root.channel-selected(target);
            root.reveal(target);
        }
    }

    function select-group(index: int) {
        if (root.groups.length > 0) {
            let target = max(0, min(root.groups.length - 1, index));
            root.group-selected(target);
            groups.reveal(target);
        }
    }

    // Scrolls the channel list so row `index` is visible.
    public function reveal(index: int) {
        if (index * 74px < -list.content-y) {
            list.content-y = -index * 74px;
        } else if ((index + 1) * 74px > -list.content-y + list.visible-height) {
            list.content-y = -((index + 1) * 74px - list.visible-height);
        }
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.UpArrow) {
                root.select(root.channel-index - 1);
            } else if (event.text == Key.DownArrow) {
                root.select(root.channel-index + 1);
            } else if (event.text == Key.PageUp) {
                root.select(root.channel-index - 10);
            } else if (event.text == Key.PageDown) {
                root.select(root.channel-index + 10);
            } else if (event.text == Key.Home) {
                root.select(0);
            } else if (event.text == Key.End) {
                root.select(root.channels.length - 1);
            } else if (event.text == Key.LeftArrow) {
                root.select-group(root.group-index - 1);
            } else if (event.text == Key.RightArrow) {
                root.select-group(root.group-index + 1);
            } else if (event.text == Key.Return && root.channel-index >= 0) {
                root.watch();
            } else if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else if (key == "p") {
                root.next-provider();
            } else {
                return reject;
            }
            accept
        }
    }
    HorizontalLayout {
        Rail {
            avatar: root.avatar;
            active: 1;
            settings-clicked => {
                root.settings-clicked();
            }
            navigate(i) => {
                root.navigate(i);
            }
        }
        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                groups := GroupsColumn {
                    title: "Live TV";
                    status: root.status;
                    view-name: root.view-name;
                    groups: root.groups;
                    group-index: root.group-index;
                    group-selected(i) => {
                        root.select-group(i);
                        keys.focus();
                    }
                    switch-clicked => {
                        root.switch-clicked();
                    }
                }
                // Channels.
                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 26px;
                        padding-bottom: 14px;
                        spacing: 10px;
                        Text {
                            text: root.group-title;
                            color: Theme.text;
                            font-size: Theme.fs-xl;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.channels.length + " channels";
                            color: Theme.text-3;
                            font-size: Theme.fs-sm;
                            vertical-alignment: bottom;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        list := ListView {
                            for channel[i] in root.channels: ChannelRow {
                                item: channel;
                                selected: i == root.channel-index;
                                clicked => {
                                    root.channel-selected(i);
                                    keys.focus();
                                }
                                double-clicked => {
                                    root.channel-selected(i);
                                    root.watch();
                                }
                            }
                        }
                    }
                }
                // Preview.
                Rectangle {
                    width: 460px;
                    background: Theme.surface-1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 0px;
                        alignment: start;
                        video := Rectangle {
                            height: self.width * 9 / 16;
                            border-radius: Theme.radius-md;
                            clip: true;
                            background: #000;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.frame;
                                image-fit: fill;
                            }
                            if root.video-note != "": Text {
                                text: root.video-note;
                                color: Theme.text-2;
                                font-size: Theme.fs-sm;
                                font-weight: 600;
                            }
                            if root.current.name != "": Rectangle {
                                x: 12px;
                                y: 12px;
                                width: marker.preferred-width + 16px;
                                height: 22px;
                                border-radius: 5px;
                                background: Theme.on-image;
                                marker := LiveMarker {
                                    x: 8px;
                                    height: parent.height;
                                }
                            }
                        }
                        Rectangle {
                            height: 22px;
                        }
                        Text {
                            text: root.programme.title != "" ? root.programme.title : root.current.name;
                            color: Theme.text;
                            font-size: Theme.fs-2xl;
                            font-weight: 800;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 6px;
                        }
                        Text {
                            text: root.current.name == "" ? ""
                                : root.programme.title != "" ? root.current.name + "  ·  " + root.programme.time
                                : root.current.number + "  ·  " + root.current.group;
                            color: Theme.text-2;
                            font-size: Theme.fs-md;
                            font-weight: 500;
                            overflow: elide;
                        }
                        if root.programme.title != "": HorizontalLayout {
                            padding-top: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #ffffff29;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * max(0, root.programme.progress);
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }
                            }
                            Text {
                                text: root.programme.left;
                                color: Theme.text-3;
                                font-size: Theme.fs-sm;
                            }
                        }
                        if root.programme.description != "": Text {
                            text: root.programme.description;
                            color: Theme.text-2;
                            font-size: Theme.fs-md;
                            wrap: word-wrap;
                            overflow: elide;
                            max-height: 88px;
                        }
                        Rectangle {
                            height: 14px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            if root.current.archive != "": Tag {
                                text: root.current.archive;
                            }
                        }
                        Rectangle {
                            height: 20px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            if root.current.name != "": Button {
                                kind: ButtonKind.primary;
                                text: "Watch";
                                hint: "Enter";
                                icon: @image-url("icons/play.svg");
                                has-icon: true;
                                clicked => {
                                    root.watch();
                                }
                            }
                        }
                        if root.upcoming.length > 0: VerticalLayout {
                            padding-top: 24px;
                            spacing: 0px;
                            Text {
                                text: "Up next";
                                color: Theme.text-3;
                                font-size: Theme.fs-sm;
                                font-weight: 700;
                            }
                            for next in root.upcoming: VerticalLayout {
                                padding-top: 8px;
                                spacing: 8px;
                                Rectangle {
                                    height: 1px;
                                    background: Theme.line;
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    Text {
                                        width: 44px;
                                        text: next.time;
                                        color: Theme.text-3;
                                        font-size: Theme.fs-sm;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: next.title;
                                        color: Theme.text;
                                        font-size: Theme.fs-sm;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Shortcut hints.
            Rectangle {
                height: 44px;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 24px;
                    spacing: 22px;
                    alignment: start;
                    Hint {
                        keys: ["↑", "↓"];
                        label: "Channel";
                    }
                    Hint {
                        keys: ["←", "→"];
                        label: "Group";
                    }
                    Hint {
                        keys: ["PgUp", "PgDn"];
                        label: "Page";
                    }
                    Hint {
                        keys: ["Enter"];
                        label: "Watch";
                    }
                    Hint {
                        keys: ["P"];
                        label: "Provider";
                    }
                }
            }
        }
    }
}
