// The selected channel beside a list: live video, what is on, and Watch
// and Favorite. Shared by Live TV and Favorites.

import { Theme } from "theme.slint";
import { Button, ButtonKind, LiveMarker, ProviderTag, Tag } from "atoms.slint";
import { ChannelItem, ProgrammeInfo, UpcomingItem } from "models.slint";

export component ChannelPreview inherits Rectangle {
    in property <image> frame;
    in property <string> video-note;
    in property <ChannelItem> current;
    in property <ProgrammeInfo> programme;
    in property <[UpcomingItem]> upcoming;
    // The favorite button's label when the channel is one.
    in property <string> favorite-text: "Favorite";
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;
    callback watch();
    callback favorite();

    width: 460px;
    background: Theme.surface-1;
    VerticalLayout {
        padding: 24px;
        spacing: 0px;
        alignment: start;
        video := Rectangle {
            height: self.width * 9 / 16;
            border-radius: Theme.radius-md;
            clip: true;
            background: #000;
            Image {
                width: 100%;
                height: 100%;
                source: root.frame;
                image-fit: fill;
            }
            if root.video-note != "": Text {
                text: root.video-note;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                font-weight: 600;
            }
            if root.current.name != "": Rectangle {
                x: 12px;
                y: 12px;
                width: marker.preferred-width + 16px;
                height: 22px;
                border-radius: 5px;
                background: Theme.on-image;
                marker := LiveMarker {
                    x: 8px;
                    height: parent.height;
                }
            }
        }
        Rectangle {
            height: 22px;
        }
        Text {
            text: root.programme.title != "" ? root.programme.title : root.current.name;
            color: Theme.text;
            font-size: Theme.fs-2xl;
            font-weight: 800;
            wrap: word-wrap;
        }
        Rectangle {
            height: 6px;
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.current.name == "" ? ""
                    : root.programme.title != "" ? root.current.name + "  ·  " + root.programme.time
                    : root.current.gone ? root.current.group
                    : root.current.number + "  ·  " + root.current.group;
                color: Theme.text-2;
                font-size: Theme.fs-md;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.current.provider != "": ProviderTag {
                text: root.current.provider;
                hue: root.current.hue;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.programme.title != "": HorizontalLayout {
            padding-top: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff29;
                    Rectangle {
                        x: 0;
                        width: parent.width * max(0, root.programme.progress);
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }
            Text {
                text: root.programme.left;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
            }
        }
        if root.programme.description != "": Text {
            text: root.programme.description;
            color: Theme.text-2;
            font-size: Theme.fs-md;
            wrap: word-wrap;
            overflow: elide;
            max-height: 88px;
        }
        Rectangle {
            height: 14px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            if root.current.archive != "": Tag {
                text: root.current.archive;
            }
        }
        Rectangle {
            height: 20px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 10px;
            if root.current.name != "": Button {
                kind: ButtonKind.primary;
                text: "Watch";
                hint: "Enter";
                icon: @image-url("icons/play.svg");
                has-icon: true;
                enabled: !root.current.gone;
                clicked => {
                    root.watch();
                }
            }
            if root.current.name != "": Button {
                text: root.current.favorite ? root.favorite-text : "Favorite";
                hint: "F";
                icon: root.current.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                has-icon: true;
                on: root.current.favorite;
                clicked => {
                    root.favorite();
                }
            }
        }
        if root.upcoming.length > 0: VerticalLayout {
            padding-top: 24px;
            spacing: 0px;
            Text {
                text: "Up next";
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                font-weight: 700;
            }
            for next in root.upcoming: VerticalLayout {
                padding-top: 8px;
                spacing: 8px;
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    spacing: 14px;
                    Text {
                        // Room for "12:30 PM".
                        width: 66px;
                        text: next.time;
                        color: Theme.text-3;
                        font-size: Theme.fs-sm;
                        font-weight: 600;
                    }
                    Text {
                        text: next.title;
                        color: Theme.text;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}
