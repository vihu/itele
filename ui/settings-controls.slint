// Controls of the Settings screen: section items, a section header, a row
// naming a setting beside its control, a segmented choice, a stepper, a
// switch, and a dropdown.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind } from "atoms.slint";

export component SectionItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> count;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-2 : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                colorize: root.selected ? Theme.accent : Theme.text-2;
            }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-2;
            font-size: Theme.fs-md;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.count;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// What a setting is on the left, its control (the children) on the right.
export component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    HorizontalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 32px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs-md;
                font-weight: 600;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.line;
    }
}

// One of a few choices, side by side.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback chosen(int);
    height: 40px;
    width: row.preferred-width;
    border-radius: Theme.radius-md;
    background: Theme.surface-2;
    row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            width: label.preferred-width + 28px;
            border-radius: 7px;
            background: i == root.selected ? Theme.surface-4 : transparent;
            label := Text {
                text: option;
                color: i == root.selected || touch.has-hover ? Theme.text : Theme.text-2;
                font-size: Theme.fs-sm;
                font-weight: 600;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }
}

// A value with − and + either side.
export component Stepper inherits Rectangle {
    in property <string> value;
    callback step(int);
    height: 40px;
    width: 148px;
    border-radius: Theme.radius-md;
    background: Theme.surface-2;
    HorizontalLayout {
        for sign[i] in [-1, 0, 1]: Rectangle {
            width: sign == 0 ? 68px : 40px;
            if sign != 0: Text {
                text: sign < 0 ? "−" : "+";
                color: touch.has-hover ? Theme.text : Theme.text-2;
                font-size: Theme.fs-lg;
                font-weight: 600;
            }
            if sign == 0: Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.fs-md;
                font-weight: 600;
            }
            touch := TouchArea {
                enabled: sign != 0;
                mouse-cursor: pointer;
                clicked => {
                    root.step(sign);
                }
            }
        }
    }
}

// A section's title, what it is for, and its main button.
export component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> action;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    spacing: 24px;
    padding-bottom: 10px;
    VerticalLayout {
        spacing: 4px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-xl;
            font-weight: 700;
        }
        Text {
            text: root.description;
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
    if root.action != "": VerticalLayout {
        alignment: end;
        Button {
            kind: ButtonKind.secondary;
            text: root.action;
            icon: root.icon;
            has-icon: true;
            enabled: root.enabled;
            clicked => {
                root.clicked();
            }
        }
    }
}

// On or off.
export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Theme.accent : Theme.surface-4;
    Rectangle {
        x: root.on ? 21px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.accent-ink : Theme.text-2;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

// One of many choices, picked from a list below it.
export component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback chosen(int);
    width: 200px;
    height: 40px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.surface-3 : Theme.surface-2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
            color: Theme.text;
            font-size: Theme.fs-md;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/down.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.text-3;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.options.length * 38px + 12px, 340px);
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.surface-2;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000080;
            clip: true;
            ListView {
                y: 6px;
                height: parent.height - 12px;
                for option[i] in root.options: Rectangle {
                    height: 38px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Rectangle {
                            border-radius: Theme.radius-sm;
                            background: row.has-hover ? Theme.surface-3 : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    width: 16px;
                                    if i == root.selected: Image {
                                        source: @image-url("icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                    }
                                }
                                Text {
                                    text: option;
                                    color: i == root.selected ? Theme.accent : Theme.text;
                                    font-size: Theme.fs-md;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            row := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.chosen(i);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
