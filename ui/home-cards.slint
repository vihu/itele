// The cards on Home: a row's title, a title left unfinished, and a
// favorite channel with what is on. Layout: .ai-docs/mockups/01-home.html.

import { Theme } from "theme.slint";
import { ChannelLogo, ProviderTag } from "atoms.slint";
import { ChannelItem, HomeCard } from "models.slint";

// A row's title.
export component SectionHead inherits Text {
    color: Theme.text;
    font-size: Theme.fs-xl;
    font-weight: 700;
    height: 56px;
    vertical-alignment: center;
}

// A title left unfinished: its picture with how far it was watched.
export component UnfinishedCard inherits Rectangle {
    in property <HomeCard> card;
    in property <bool> selected;
    callback clicked();
    width: 300px;
    VerticalLayout {
        spacing: 0px;
        alignment: start;
        Rectangle {
            height: 169px;
            border-radius: Theme.radius-md;
            clip: true;
            background: @linear-gradient(160deg, root.card.tint 0%, Theme.surface-1 100%);
            if root.card.has-image: Image {
                width: 100%;
                height: 100%;
                source: root.card.image;
                image-fit: cover;
            }
            if !root.card.has-image: Text {
                x: 16px;
                y: parent.height - self.height - 22px;
                width: parent.width - 32px;
                text: root.card.title;
                color: Theme.text;
                font-size: Theme.fs-xl;
                font-weight: 800;
                wrap: word-wrap;
            }
            Rectangle {
                x: 12px;
                y: parent.height - 12px;
                width: parent.width - 24px;
                height: 4px;
                border-radius: 2px;
                background: #ffffff4d;
                Rectangle {
                    x: 0;
                    width: parent.width * root.card.progress;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
            if root.selected || touch.has-hover: Rectangle {
                border-radius: Theme.radius-md;
                border-width: root.selected ? 3px : 1px;
                border-color: root.selected ? Theme.accent : Theme.accent-line;
            }
        }
        Text {
            text: root.card.title;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: Theme.fs-md;
            font-weight: 600;
            overflow: elide;
            height: 34px;
            vertical-alignment: bottom;
        }
        Text {
            text: root.card.detail;
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A favorite channel with what is on now and next.
export component ChannelCard inherits Rectangle {
    in property <ChannelItem> item;
    in property <bool> selected;
    callback clicked();
    width: 300px;
    height: 150px;
    border-radius: Theme.radius-md;
    background: touch.has-hover || root.selected ? Theme.surface-2 : Theme.surface-1;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.accent;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                ChannelLogo {
                    short: root.item.short;
                    tint: root.item.tint;
                    logo: root.item.logo;
                    has-logo: root.item.has-logo;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.name;
                    color: Theme.text;
                    font-size: Theme.fs-sm;
                    font-weight: 600;
                    overflow: elide;
                }
                HorizontalLayout {
                    alignment: start;
                    ProviderTag {
                        text: root.item.provider;
                        hue: root.item.hue;
                    }
                }
            }
        }
        Text {
            text: root.item.now-title != "" ? root.item.now-title : "No guide";
            color: root.item.now-title != "" ? Theme.text : Theme.text-3;
            font-size: Theme.fs-md;
            font-weight: 600;
            overflow: elide;
        }
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: root.item.now-progress >= 0 ? #ffffff29 : transparent;
            Rectangle {
                x: 0;
                width: parent.width * max(0, root.item.now-progress);
                border-radius: 1.5px;
                background: Theme.accent;
            }
        }
        Text {
            text: root.item.next-title != "" ? root.item.next-time + " · " + root.item.next-title : "";
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
