// The detail page of a movie or a series: backdrop (or the poster), title,
// metadata, plot, credits and Play; a series adds season tabs and its
// episodes. Layout: .ai-docs/mockups/06-series.html.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind } from "atoms.slint";
import { EpisodeItem, SeasonItem, TitleDetails } from "models.slint";
import { Rail } from "rail.slint";

export { EpisodeItem, SeasonItem, TitleDetails }

component SeasonTab inherits Rectangle {
    in property <SeasonItem> item;
    in property <bool> selected;
    callback clicked();
    width: 136px;
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: root.item.name;
            color: root.selected ? Theme.text : touch.has-hover ? Theme.text : Theme.text-2;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.item.count;
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }
    if root.selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component EpisodeRow inherits Rectangle {
    in property <EpisodeItem> item;
    in property <bool> selected;
    callback clicked();
    height: 118px;
    border-radius: Theme.radius-md;
    background: selected ? Theme.surface-2 : touch.has-hover ? Theme.surface-1 : transparent;
    border-width: selected ? 1px : 0px;
    border-color: Theme.accent-line;
    HorizontalLayout {
        padding: 12px;
        spacing: 22px;
        Text {
            width: 30px;
            text: root.item.number;
            color: root.selected ? Theme.accent : Theme.text-3;
            font-size: Theme.fs-lg;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: 168px;
            border-radius: Theme.radius-sm;
            clip: true;
            background: Theme.surface-2;
            if root.item.has-still: Image {
                width: 100%;
                height: 100%;
                source: root.item.still;
                image-fit: cover;
            }
            if root.item.resumable: Rectangle {
                x: 8px;
                y: parent.height - 12px;
                width: parent.width - 16px;
                height: 4px;
                border-radius: 2px;
                background: #ffffff4d;
                Rectangle {
                    x: 0;
                    width: parent.width * root.item.progress;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                color: Theme.text;
                font-size: Theme.fs-md;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.plot;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
                overflow: elide;
                max-height: 38px;
            }
        }
        HorizontalLayout {
            width: 120px;
            alignment: end;
            spacing: 6px;
            if root.item.watched: VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("icons/check.svg");
                    width: 14px;
                    height: 14px;
                    colorize: Theme.text-2;
                }
            }
            Text {
                text: root.item.watched ? "Watched" : root.item.resumable ? root.item.left : root.item.duration;
                color: root.item.resumable || root.selected ? Theme.accent : root.item.watched ? Theme.text-2 : Theme.text-3;
                font-size: Theme.fs-sm;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component DetailsScreen inherits Rectangle {
    in property <TitleDetails> details;
    in property <string> avatar;
    // The rail item to highlight: 3 movies, 4 series.
    in property <int> rail-active;
    // A series' page: seasons and episodes below a shorter hero.
    in property <bool> series;
    in property <[SeasonItem]> seasons;
    in property <int> season-index;
    in property <[EpisodeItem]> episodes;
    in-out property <int> episode-index;
    callback play();
    callback restart();
    callback back();
    callback season-selected(int);
    callback navigate(int);
    callback settings-clicked();

    public function focus-keys() {
        keys.focus();
    }

    // Scrolls the episodes so the selected one is visible; rows are 118px.
    public function reveal-episode() {
        let top = root.episode-index * 118px;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + 118px > -list.content-y + list.visible-height) {
            list.content-y = -(top + 118px - list.visible-height);
        }
        if (root.season-index * 136px < -tabs.content-x) {
            tabs.content-x = -root.season-index * 136px;
        } else if ((root.season-index + 1) * 136px > -tabs.content-x + tabs.width) {
            tabs.content-x = -((root.season-index + 1) * 136px - tabs.width);
        }
    }

    property <length> hero-height: 400px;
    // A series' main button follows the selected episode.
    property <bool> has-episode: root.series && root.episode-index >= 0 && root.episode-index < root.episodes.length;
    property <EpisodeItem> episode: root.has-episode ? root.episodes[root.episode-index] : { progress: -1 };
    property <string> play-text: !root.series ? root.details.play-label
        : root.has-episode ? (root.episode.resumable ? "Resume " : "Play ") + root.episode.code
        : "Play";
    property <string> left-text: root.series ? root.episode.left : root.details.left;
    property <bool> can-restart: root.series ? root.episode.resumable : root.details.restart;

    function select-episode(index: int) {
        if (root.episodes.length > 0) {
            root.episode-index = max(0, min(root.episodes.length - 1, index));
            root.reveal-episode();
        }
    }

    function select-season(index: int) {
        if (index >= 0 && index < root.seasons.length && index != root.season-index) {
            root.season-selected(index);
        }
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.Return || key == " ") {
                root.play();
            } else if (key == "b" && root.can-restart) {
                root.restart();
            } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.back();
            } else if (root.series && event.text == Key.UpArrow) {
                root.select-episode(root.episode-index - 1);
            } else if (root.series && event.text == Key.DownArrow) {
                root.select-episode(root.episode-index + 1);
            } else if (root.series && event.text == Key.LeftArrow) {
                root.select-season(root.season-index - 1);
            } else if (root.series && event.text == Key.RightArrow) {
                root.select-season(root.season-index + 1);
            } else if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else {
                return reject;
            }
            accept
        }

        HorizontalLayout {
            Rail {
                avatar: root.avatar;
                active: root.rail-active;
                navigate(i) => {
                    root.navigate(i);
                }
                settings-clicked => {
                    root.settings-clicked();
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Rectangle {
                    vertical-stretch: root.series ? 0 : 1;
                    min-height: root.series ? root.hero-height : 0px;
                    max-height: root.series ? root.hero-height : 100000px;
                    clip: true;
                    // The backdrop, faded into the page on the left and below.
                    if root.details.has-backdrop: Rectangle {
                        x: parent.width * 0.26;
                        width: parent.width * 0.74;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.details.backdrop;
                            image-fit: cover;
                        }
                        Rectangle {
                            background: @linear-gradient(90deg, Theme.bg 0%, #0b0c10d1 22%, #0b0c1000 58%);
                        }
                        Rectangle {
                            background: @linear-gradient(0deg, Theme.bg 0%, #0b0c1000 40%);
                        }
                    }
                    // Without one, the poster stands on the right.
                    if !root.details.has-backdrop: Rectangle {
                        height: min(parent.height - 96px, 600px);
                        width: self.height / 1.5;
                        x: parent.width - self.width - 64px;
                        y: 48px;
                        border-radius: Theme.radius-lg;
                        clip: true;
                        background: @linear-gradient(180deg, root.details.tint 0%, Theme.surface-1 100%);
                        if root.details.has-poster: Image {
                            width: 100%;
                            height: 100%;
                            source: root.details.poster;
                            image-fit: cover;
                        }
                    }
                    Button {
                        x: 48px;
                        y: 24px;
                        width: self.preferred-width;
                        kind: ButtonKind.secondary;
                        text: root.details.back-label;
                        icon: @image-url("icons/arrow-left.svg");
                        has-icon: true;
                        clicked => {
                            root.back();
                        }
                    }
                    VerticalLayout {
                        x: 48px;
                        width: min(640px, parent.width * 0.52);
                        height: self.preferred-height;
                        y: parent.height - self.height - (root.series ? 28px : 56px);
                        spacing: 12px;
                        Text {
                            text: root.details.title;
                            color: Theme.text;
                            font-size: root.series ? Theme.fs-3xl : Theme.fs-4xl;
                            font-weight: 800;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 14px;
                            if root.details.meta != "": Text {
                                text: root.details.meta;
                                color: Theme.text-2;
                                font-size: Theme.fs-md;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            if root.details.rating != "": HorizontalLayout {
                                spacing: 5px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/star.svg");
                                        width: 15px;
                                        height: 15px;
                                        colorize: Theme.accent;
                                    }
                                }
                                Text {
                                    text: root.details.rating;
                                    color: Theme.text;
                                    font-size: Theme.fs-md;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.details.plot != "": Text {
                            text: root.details.plot;
                            color: Theme.text-2;
                            font-size: Theme.fs-md;
                            wrap: word-wrap;
                            overflow: elide;
                            max-height: root.series ? 66px : 120px;
                        }
                        if root.details.credits != "": Text {
                            text: root.details.credits;
                            color: Theme.text-3;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                            overflow: elide;
                            max-height: 40px;
                        }
                        if root.details.note != "": Text {
                            text: root.details.note;
                            color: Theme.text-3;
                            font-size: Theme.fs-sm;
                        }
                        HorizontalLayout {
                            padding-top: 8px;
                            alignment: start;
                            spacing: 12px;
                            Button {
                                kind: ButtonKind.primary;
                                text: root.play-text;
                                hint: "Enter";
                                icon: @image-url("icons/play.svg");
                                has-icon: true;
                                clicked => {
                                    root.play();
                                }
                            }
                            if root.left-text != "": Text {
                                text: root.left-text;
                                color: Theme.text-3;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                            if root.can-restart: Button {
                                kind: ButtonKind.secondary;
                                text: "From the beginning";
                                hint: "B";
                                icon: @image-url("icons/back.svg");
                                has-icon: true;
                                clicked => {
                                    root.restart();
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    visible: root.series;
                    height: root.series ? 50px : 0px;
                    tabs := Flickable {
                        x: 40px;
                        width: parent.width - 80px;
                        content-width: max(self.width, root.seasons.length * 136px);
                        interactive: false;
                        HorizontalLayout {
                            alignment: start;
                            for season[i] in root.seasons: SeasonTab {
                                item: season;
                                selected: i == root.season-index;
                                clicked => {
                                    root.select-season(i);
                                    keys.focus();
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }
                HorizontalLayout {
                    visible: root.series;
                    vertical-stretch: root.series ? 1 : 0;
                    max-height: root.series ? 100000px : 0px;
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-top: 8px;
                    list := ListView {
                        for episode[i] in root.episodes: EpisodeRow {
                            item: episode;
                            selected: i == root.episode-index;
                            clicked => {
                                root.episode-index = i;
                                keys.focus();
                                root.play();
                            }
                        }
                    }
                }
            }
        }
    }
}
