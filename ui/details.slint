// The detail page of a movie: backdrop (or the poster), title, metadata,
// plot, credits and Play. Layout: the hero of .ai-docs/mockups/06-series.html.

import { Theme } from "theme.slint";
import { Button, ButtonKind } from "atoms.slint";
import { TitleDetails } from "models.slint";
import { Rail } from "rail.slint";

export { TitleDetails }

export component DetailsScreen inherits Rectangle {
    in property <TitleDetails> details;
    in property <string> avatar;
    // The rail item to highlight: 3 movies, 4 series.
    in property <int> rail-active;
    callback play();
    callback back();
    callback navigate(int);
    callback settings-clicked();

    public function focus-keys() {
        keys.focus();
    }

    background: Theme.bg;
    keys := FocusScope {
        key-pressed(event) => {
            let key = event.text.to-lowercase();
            if (event.text == Key.Return || key == " ") {
                root.play();
            } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.back();
            } else if (key == "g") {
                root.navigate(2);
            } else if (event.text == "/" || (event.modifiers.control && key == "k")) {
                root.navigate(5);
            } else {
                return reject;
            }
            accept
        }

        HorizontalLayout {
            Rail {
                avatar: root.avatar;
                active: root.rail-active;
                navigate(i) => {
                    root.navigate(i);
                }
                settings-clicked => {
                    root.settings-clicked();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                // The backdrop, faded into the page on the left and below.
                if root.details.has-backdrop: Rectangle {
                    x: parent.width * 0.26;
                    width: parent.width * 0.74;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.details.backdrop;
                        image-fit: cover;
                    }
                    Rectangle {
                        background: @linear-gradient(90deg, Theme.bg 0%, #0b0c10d1 22%, #0b0c1000 58%);
                    }
                    Rectangle {
                        background: @linear-gradient(0deg, Theme.bg 0%, #0b0c1000 40%);
                    }
                }
                // Without one, the poster stands on the right.
                if !root.details.has-backdrop: Rectangle {
                    height: min(parent.height - 128px, 600px);
                    width: self.height / 1.5;
                    x: parent.width - self.width - 64px;
                    y: 64px;
                    border-radius: Theme.radius-lg;
                    clip: true;
                    background: @linear-gradient(180deg, root.details.tint 0%, Theme.surface-1 100%);
                    if root.details.has-poster: Image {
                        width: 100%;
                        height: 100%;
                        source: root.details.poster;
                        image-fit: cover;
                    }
                }
                Button {
                    x: 48px;
                    y: 24px;
                    width: self.preferred-width;
                    kind: ButtonKind.secondary;
                    text: root.details.back-label;
                    icon: @image-url("icons/arrow-left.svg");
                    has-icon: true;
                    clicked => {
                        root.back();
                    }
                }
                copy := VerticalLayout {
                    x: 48px;
                    width: min(640px, parent.width * 0.52);
                    height: self.preferred-height;
                    y: parent.height - self.height - 56px;
                    spacing: 14px;
                    Text {
                        text: root.details.title;
                        color: Theme.text;
                        font-size: Theme.fs-4xl;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 14px;
                        if root.details.meta != "": Text {
                            text: root.details.meta;
                            color: Theme.text-2;
                            font-size: Theme.fs-md;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        if root.details.rating != "": HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/star.svg");
                                    width: 15px;
                                    height: 15px;
                                    colorize: Theme.accent;
                                }
                            }
                            Text {
                                text: root.details.rating;
                                color: Theme.text;
                                font-size: Theme.fs-md;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.details.plot != "": Text {
                        text: root.details.plot;
                        color: Theme.text-2;
                        font-size: Theme.fs-md;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 120px;
                    }
                    if root.details.credits != "": Text {
                        text: root.details.credits;
                        color: Theme.text-3;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 40px;
                    }
                    if root.details.note != "": Text {
                        text: root.details.note;
                        color: Theme.text-3;
                        font-size: Theme.fs-sm;
                    }
                    HorizontalLayout {
                        padding-top: 10px;
                        alignment: start;
                        spacing: 12px;
                        Button {
                            kind: ButtonKind.primary;
                            text: "Play";
                            hint: "Enter";
                            icon: @image-url("icons/play.svg");
                            has-icon: true;
                            clicked => {
                                root.play();
                            }
                        }
                    }
                }
            }
        }
    }
}
