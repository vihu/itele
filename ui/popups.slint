// The provider switcher and the providers list, shown in popups.

import { Theme } from "theme.slint";
import { Button, ButtonKind } from "atoms.slint";
import { ProviderItem } from "models.slint";

// One choice in the provider switcher.
component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    callback clicked();
    height: 52px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-3 : transparent;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.title;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: Theme.fs-md;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.text-3;
            font-size: Theme.fs-xs;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// "All providers", then each provider.
export component SwitcherPanel inherits Rectangle {
    in property <[ProviderItem]> providers;
    // The viewed provider; -1 is every provider.
    in property <int> view-index;
    callback selected(int);

    background: Theme.surface-2;
    border-radius: Theme.radius-md;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #00000073;
    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        SwitchRow {
            title: "All providers";
            detail: root.providers.length == 1 ? "1 provider" : root.providers.length + " providers";
            selected: root.view-index == -1;
            clicked => {
                root.selected(-1);
            }
        }
        for provider[i] in root.providers: SwitchRow {
            title: provider.name;
            detail: provider.status;
            selected: root.view-index == i;
            clicked => {
                root.selected(i);
            }
        }
    }
}

// Signed-in providers, each with sign out, and Add provider.
export component ProvidersPanel inherits Rectangle {
    in property <[ProviderItem]> providers;
    callback sign-out(int);
    callback add-provider();

    background: Theme.surface-2;
    border-radius: Theme.radius-lg;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #00000073;
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        Text {
            text: "Providers";
            color: Theme.text;
            font-size: Theme.fs-lg;
            font-weight: 700;
        }
        for provider[i] in root.providers: HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: provider.name;
                    color: Theme.text;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: provider.user;
                    color: Theme.text-2;
                    font-size: Theme.fs-sm;
                    overflow: elide;
                }
                Text {
                    text: provider.status;
                    color: Theme.text-3;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    kind: ButtonKind.ghost;
                    text: "Sign out";
                    clicked => {
                        root.sign-out(i);
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                kind: ButtonKind.secondary;
                text: "Add provider";
                icon: @image-url("icons/plus.svg");
                has-icon: true;
                clicked => {
                    root.add-provider();
                }
            }
        }
    }
}
